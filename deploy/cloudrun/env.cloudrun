# 云托管服务需要的环境变量（复制到云托管控制台 → 服务设置 → 环境变量）

# 必填：云托管 MySQL 连接串（控制台 → MySQL → 连接信息里复制）
# 例：mysql://user:pass@10.0.x.x:3306/yifazhilian
YIFAZHILIAN_DB_URL=

# 必填：callContainer 的 Host 不固定，必须放开
YIFAZHILIAN_ALLOWED_HOSTS=*

# 必填：审核员手机号（登录后自动获得管理台权限）
YIFAZHILIAN_ADMIN_PHONE=

# 运行模式
YIFAZHILIAN_RUNTIME_MODE=production

# 演示登录：1 = /auth/send-code 回显验证码（任何人都能登录任何账号）
# 内部试用可设 1，但请把管理员手机号换成外人不知道的号；对外必须设 0 并接真实短信
YIFAZHILIAN_DEMO_AUTH=1

# 可选：AI 问答（不填则用本地模板回答）
YIFAZHILIAN_AI_PROVIDER=
YIFAZHILIAN_AI_BASE_URL=
YIFAZHILIAN_AI_API_KEY=
YIFAZHILIAN_AI_MODEL=

# 可选：北大法宝 MCP
YIFAZHILIAN_LEGAL_MCP_TOKEN=
YIFAZHILIAN_LEGAL_MCP_UPSTREAM=https://apim-gateway.pkulaw.com/mcp-law-search-service
