# 复制成 deploy/env 后填写；这个文件不要提交到 git（.gitignore 已忽略 deploy/env）

# 域名：Caddy 用它签证书，也用于微信后台的合法域名
DOMAIN=api.example.com

# 允许的 Host 头（TrustedHostMiddleware）。必须包含上面的域名，否则接口返回 400
YIFAZHILIAN_ALLOWED_HOSTS=api.example.com

# 数据库落在 Docker 卷里，容器重建不丢
YIFAZHILIAN_DB_PATH=/data/yifazhilian.db

# 运行模式：production / demo。上线建议 production
YIFAZHILIAN_RUNTIME_MODE=production

# 演示登录：1 时 /auth/send-code 会直接返回验证码，等于任何人都能登录任何账号。
# 公开部署务必设 0，并接入真实短信；仅内部试用时保留 1。
YIFAZHILIAN_DEMO_AUTH=0

# 管理员手机号（审核员）。也可以写在 backend/admins.txt 里，两者取并集
YIFAZHILIAN_ADMIN_PHONE=

# AI 对话（可选，不填就用本地模板回答）
YIFAZHILIAN_AI_PROVIDER=
YIFAZHILIAN_AI_BASE_URL=
YIFAZHILIAN_AI_API_KEY=
YIFAZHILIAN_AI_MODEL=

# 北大法宝 MCP（可选）
YIFAZHILIAN_LEGAL_MCP_TOKEN=
YIFAZHILIAN_LEGAL_MCP_UPSTREAM=https://apim-gateway.pkulaw.com/mcp-law-search-service
YIFAZHILIAN_LEGAL_MCP_COMMAND=

# 微信登录（可选；不做微信登录可不填）
YIFAZHILIAN_WECHAT_APP_ID=
YIFAZHILIAN_WECHAT_APP_SECRET=
