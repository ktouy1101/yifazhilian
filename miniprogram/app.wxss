/* Colors, typography and geometry from the supplied HTML demo. */
page { --paper:#F3F8F9; --paper-2:#E8F1F2; --card:#fff; --ink:#132930; --ink-2:#51686F; --ink-3:#8AA0A6; --line:#E2ECEE; --med:#0E7C86; --med-soft:#E2F2F3; --med-deep:#0A5A61; --law:#274060; --law-soft:#E8EDF5; --warm:#E8845C; --warm-soft:#FCEEE6; --warm-deep:#C9613C; --danger:#E0564B; --danger-soft:#FCE9E7; --ok:#3FA67A; --ok-soft:#E4F4EE; background:#F3F8F9; color:#132930; font-size:26rpx; line-height:1.55; font-family:'PingFang SC','Microsoft YaHei',sans-serif; }
view,text,button,input,textarea,scroll-view { box-sizing:border-box; }
button { margin:0; padding:0; border:0; border-radius:0; background:transparent; color:inherit; font-size:inherit; line-height:inherit; font-family:inherit; font-weight:inherit; }
button::after { border:0; } button[disabled] { opacity:.5; }
/* Override the native v2 default fixed-width buttons before applying component styles. */
button:not([size='mini']) { width:auto; margin:0; padding:0; min-height:0; }
.page { padding:28rpx 32rpx 44rpx; }
.card { background:#fff; border-radius:44rpx; padding:30rpx; margin-bottom:24rpx; box-shadow:0 16rpx 48rpx -34rpx rgba(16,66,74,.35); }
.section-title { display:flex; align-items:center; gap:16rpx; font-size:28rpx; font-weight:700; }
.section-title .more { margin-left:auto; color:#8AA0A6; font-size:23rpx; font-weight:400; }
.row { display:flex; align-items:center; }
.muted { color:#51686F; font-size:25rpx; } .tiny { color:#8AA0A6; font-size:22rpx; }
.icon { width:36rpx; height:36rpx; flex-shrink:0; }
button.btn, .btn { display:inline-flex; align-items:center; justify-content:center; gap:14rpx; padding:22rpx 34rpx; border-radius:56rpx; background:linear-gradient(135deg,#0E7C86,#0A5A61); color:#fff; font-size:28rpx; font-weight:600; box-shadow:0 20rpx 40rpx -22rpx #0E7C86; }
.btn.sm { padding:16rpx 26rpx; border-radius:40rpx; font-size:25rpx; }
.btn.ghost { color:#132930; background:#fff; box-shadow:0 0 0 2rpx #E2ECEE; font-weight:500; }
.btn.law { background:linear-gradient(135deg,#35577E,#274060); box-shadow:0 20rpx 40rpx -22rpx #274060; }
.btn.warm { background:linear-gradient(135deg,#E8845C,#C9613C); box-shadow:0 20rpx 40rpx -22rpx #E8845C; }
.btn.danger { background:linear-gradient(135deg,#E96A5F,#E0564B); box-shadow:0 20rpx 40rpx -22rpx #E0564B; }
.chip { display:inline-flex; align-items:center; flex-shrink:0; gap:8rpx; padding:6rpx 18rpx; border-radius:40rpx; font-size:21rpx; font-weight:600; }
.chip.med { background:#E2F2F3; color:#0A5A61; } .chip.law { background:#E8EDF5; color:#274060; }
.chip.ok { background:#E4F4EE; color:#2C7A59; } .chip.warm { background:#FCEEE6; color:#C9613C; }
.chip.danger { background:#FCE9E7; color:#C23F34; } .chip.warn { background:#FBF2DE; color:#A9791F; }
.press { opacity:.76; }
.demo-caption { text-align:center; color:#8AA0A6; font-size:21rpx; line-height:1.65; padding:8rpx 0; }
