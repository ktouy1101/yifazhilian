page { background: #f4f8f8; color: #172f34; font-size: 36rpx; line-height: 1.6; }
.page { padding: 28rpx; padding-bottom: 70rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; border: 1rpx solid #d9e4e6; }
.title { font-size: 44rpx; font-weight: 700; margin-bottom: 16rpx; }
.small { font-size: 30rpx; color: #455f65; }
.notice { background: #fff1d6; padding: 20rpx; border-radius: 16rpx; margin-bottom: 24rpx; font-size: 30rpx; color: #654413; }
button { min-height: 104rpx; margin: 18rpx 0; font-size: 36rpx; border-radius: 16rpx; background: #e5f2f3; color: #075d66; }
button.primary { background: #0e7c86; color: #fff; }
button.danger { background: #ae2339; color: white; }
textarea { width: 100%; min-height: 150rpx; box-sizing: border-box; padding: 16rpx; border: 2rpx solid #79989e; border-radius: 12rpx; background: #fff; }
.message { white-space: pre-wrap; word-break: break-all; }
