.intro { margin:8rpx 0 30rpx; }.eyebrow { font-size:22rpx; color:#0E7C86; letter-spacing:2rpx; }.headline { font-size:38rpx; font-weight:700; margin:10rpx 0; }
.capture-grid { display:flex; gap:20rpx; }.capture-grid button { border-radius:32rpx; padding:30rpx 20rpx; flex:1; text-align:left; font-weight:600; }.capture-grid image { width:48rpx; height:48rpx; margin-bottom:18rpx; }.capture-grid text { display:block; font-size:21rpx; margin-top:8rpx; font-weight:400; }.capture-main { background:#0E7C86; color:#fff; }.capture-album { background:#E2F2F3; color:#0A5A61; }
.privacy-line { display:flex; align-items:center; justify-content:center; gap:8rpx; font-size:22rpx; color:#51686F; margin:24rpx 0 32rpx; }.privacy-line image { width:26rpx; height:26rpx; }
.checklist-card { padding:26rpx 28rpx; margin-bottom:22rpx; }
.checklist-tabs { display:flex; gap:10rpx; margin:8rpx 0 18rpx; }
.checklist-tabs button { flex:1; width:auto; padding:12rpx 8rpx; border-radius:20rpx; font-size:23rpx; color:#51686F; background:#F1F6F6; }
.checklist-tabs button.selected { background:#DDEFF0; color:#0A5A61; font-weight:700; }
.checklist-progress { font-size:25rpx; font-weight:700; color:#21424A; padding:14rpx 0; border-top:1rpx solid #E7F0F1; }
.checklist-item { display:flex; align-items:flex-start; gap:14rpx; padding:16rpx 0; border-bottom:1rpx solid #F0F6F6; }
.check-icon { flex:0 0 38rpx; width:38rpx; height:38rpx; line-height:38rpx; text-align:center; border-radius:50%; font-size:22rpx; font-weight:700; background:#EDF2F2; color:#617B82; }
.checklist-item.complete .check-icon { background:#DFF2E8; color:#217A4A; }
.checklist-item.pending .check-icon { background:#FCF2E2; color:#A9791F; }
.checklist-item.missing .check-icon { background:#FCE9E7; color:#A9342B; }
.check-main { flex:1; min-width:0; }.check-label { font-size:25rpx; font-weight:600; color:#274B53; }
.check-required { margin-left:10rpx; padding:2rpx 8rpx; border-radius:8rpx; font-size:19rpx; font-weight:400; color:#617B82; background:#F1F6F6; }
.check-status { flex:0 0 auto; font-size:21rpx; color:#617B82; }
.checklist-foot { margin-top:14rpx; font-size:21rpx; line-height:1.7; color:#617B82; }
.search { background:#fff; border-radius:22rpx; padding:22rpx; font-size:25rpx; height:88rpx; }.filters { display:flex; gap:14rpx; margin:24rpx 0; }.filters button { padding:12rpx 24rpx; border-radius:30rpx; color:#51686F; }.filters .selected { background:#DDEFF0; color:#0A5A61; font-weight:600; }.filters .refresh { margin-left:auto; }
button.document { width:100%; padding:28rpx; text-align:left; margin-bottom:20rpx; }.document-top,.document-bottom { display:flex; justify-content:space-between; gap:12rpx; align-items:center; }.document-title { font-size:30rpx; font-weight:600; overflow-wrap:anywhere; }.document .muted { margin-top:12rpx; }.document-bottom { margin-top:20rpx; padding-top:18rpx; border-top:1rpx solid #E2ECEE; font-size:22rpx; color:#51686F; }
.empty .section-title { margin-bottom:16rpx; }.empty .btn { margin-top:24rpx; }.empty-icon { width:64rpx; height:64rpx; margin:12rpx 0 20rpx; }.footnote { color:#637B82; font-size:22rpx; margin-top:28rpx; text-align:center; }.error { padding:24rpx; border-radius:20rpx; background:#FCE9E7; color:#A9342B; }.error button { margin-top:12rpx; text-decoration:underline; }.loading { padding:24rpx; text-align:center; color:#51686F; }
.notes-block { margin-top:46rpx; padding-top:28rpx; border-top:1rpx solid #E2ECEE; }
.notes-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:10rpx; }
.notes-head .section-title { font-size:30rpx; font-weight:700; }
.notes-add { width:auto; margin:0; padding:10rpx 6rpx; font-size:23rpx; line-height:1.5; color:#0E7C86; background:transparent; }
.note-card { padding:26rpx 28rpx; margin-top:16rpx; }
.note-date { flex-shrink:0; font-size:21rpx; color:#8AA0A6; }
.note-body { margin-top:18rpx; padding-top:16rpx; border-top:1rpx dashed #E2ECEE; font-size:24rpx; line-height:1.75; color:#51686F; white-space:pre-wrap; word-break:break-all; }
.notes-block .empty { margin-top:16rpx; }
