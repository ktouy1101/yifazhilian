button.primary-button{display:flex;align-items:center;justify-content:center;width:100%;padding:23rpx 28rpx;border-radius:24rpx;background:#0E7C86;color:#fff;font-size:28rpx;font-weight:650;line-height:1.6}
button.records-entry{display:flex;align-items:center;gap:20rpx;width:100%;padding:26rpx 28rpx;margin-bottom:26rpx;border:1rpx solid #DCEBEC;text-align:left;line-height:1.5}
.records-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;flex-shrink:0;background:#E2F2F3;border-radius:22rpx}
.records-icon image{width:38rpx;height:38rpx}.records-main{flex:1;min-width:0}.records-title{font-size:28rpx;font-weight:700;color:#21424A}.records-caption{margin-top:7rpx;font-size:22rpx;line-height:1.6;color:#617B82}.records-arrow{width:28rpx;height:28rpx;flex-shrink:0}
button.records-entry-pressed{background:#EDF7F6}
.summary-entry .records-icon{background:#E8EDF5}
.summary-entry .records-title{color:#274060}
.summary-periods{margin:18rpx 0 4rpx}
.summary-section{background:#F7FAFA;border:1rpx solid #E3ECEE;border-radius:22rpx;padding:22rpx 24rpx;margin:16rpx 0}
.summary-section-title{font-size:26rpx;font-weight:700;color:#21424A;margin-bottom:10rpx}
.summary-line{font-size:25rpx;line-height:1.8;color:#42626A;word-break:break-all}
.visit-card{padding:26rpx 28rpx}
.record-fields{margin:16rpx 0;border-top:1rpx solid #E7F0F1;border-bottom:1rpx solid #E7F0F1}
.record-field{display:flex;justify-content:space-between;gap:20rpx;padding:12rpx 0;font-size:24rpx;color:#3D5C64;border-bottom:1rpx solid #F0F6F6}
.record-field:last-child{border-bottom:0}
.record-field-name{flex:1;min-width:0;word-break:break-all}
.record-field-value{flex:0 0 auto;font-weight:600;color:#163D45}
.symptom-card{padding:24rpx 28rpx}
.status-summary{padding:24rpx 28rpx;line-height:1.8;font-size:24rpx;color:#3D5C64}
button.question-entry{display:flex;align-items:center;justify-content:space-between;width:100%;text-align:left;padding:26rpx 28rpx;margin-bottom:24rpx}
.care-alert{border-radius:28rpx;padding:26rpx 28rpx;margin:0 0 24rpx;border:1rpx solid #E2ECEE;background:#F7FAFA}
.care-alert.urgent{background:#FCE9E7;border-color:#F1C8C1}
.care-alert.due,.care-alert.soon{background:#FCF2E2;border-color:#F0D7AE}
.care-alert-title{font-size:28rpx;font-weight:700;color:#21424A}
.care-alert.urgent .care-alert-title{color:#A9342B}
.care-alert-copy{margin-top:10rpx;font-size:24rpx;line-height:1.7;color:#51686F}
button.care-alert-action{margin-top:18rpx;min-height:64rpx;padding:12rpx 24rpx;border-radius:32rpx;font-size:23rpx;font-weight:600;color:#fff;background:#0E7C86}
.care-alert.urgent button.care-alert-action{background:#C9613C}
.care-alert.due button.care-alert-action,.care-alert.soon button.care-alert-action{background:#A9791F}
.time-list{display:flex;flex-direction:column;gap:12rpx}
.time-row{display:flex;align-items:center;gap:12rpx}
.time-row picker{flex:1;min-width:0}
.time-choice{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;min-height:84rpx;padding:20rpx 23rpx;background:#F1F6F6;border:1rpx solid #DEE9EB;border-radius:18rpx}
.time-value{font-size:31rpx;font-weight:700;color:#0E7C86;font-variant-numeric:tabular-nums;letter-spacing:2rpx}
.time-caret{font-size:24rpx;color:#617B82}
button.time-remove{width:auto;flex-shrink:0;margin:0;padding:18rpx 16rpx;background:transparent;color:#A14E45;font-size:23rpx;line-height:1.5}
button.add-time{width:100%;margin-top:14rpx;padding:18rpx;border-radius:18rpx;background:#EDF4F5;color:#0E7C86}
.access-note{font-size:21rpx;color:#2C7A59;margin-top:10rpx}

/* 玻璃拟态（2026-11-07） */
.hero-title-row{margin-top:8rpx}
.hero-title{background:linear-gradient(135deg,#0B3F47,#0E7C86 72%);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero-tag{background:rgba(255,255,255,.62);border-color:rgba(255,255,255,.85);-webkit-backdrop-filter:blur(16rpx);backdrop-filter:blur(16rpx)}
.tabs{box-shadow:inset 0 1rpx 0 rgba(255,255,255,.8)}
.summary-grid{background:rgba(255,255,255,.66);-webkit-backdrop-filter:blur(24rpx);backdrop-filter:blur(24rpx);border:1rpx solid rgba(255,255,255,.75);box-shadow:0 18rpx 50rpx -32rpx rgba(16,66,74,.45)}
.care-alert{background:rgba(255,255,255,.66);-webkit-backdrop-filter:blur(22rpx);backdrop-filter:blur(22rpx);box-shadow:0 18rpx 44rpx -30rpx rgba(16,66,74,.4)}
.care-alert.urgent{background:rgba(252,233,231,.78)}
.care-alert.due,.care-alert.soon{background:rgba(252,242,226,.78)}
.summary-section{background:rgba(255,255,255,.55);border-color:rgba(255,255,255,.8)}
.records-entry,.question-entry,.visit-card,.status-summary,.symptom-card{
  background:rgba(255,255,255,.66);
  -webkit-backdrop-filter:blur(24rpx);backdrop-filter:blur(24rpx);
  border:1rpx solid rgba(255,255,255,.75);
  box-shadow:0 18rpx 48rpx -32rpx rgba(16,66,74,.45)}
button.records-entry-pressed{background:rgba(255,255,255,.85)}
/* hero 玻璃面板（2026-11-07） */
.hero{
  background:rgba(255,255,255,.55);
  -webkit-backdrop-filter:blur(30rpx) saturate(180%);
  backdrop-filter:blur(30rpx) saturate(180%);
  border:1rpx solid rgba(255,255,255,.78);
  border-radius:36rpx;
  padding:30rpx 30rpx 28rpx;
  margin:6rpx 0 24rpx;
  box-shadow:0 24rpx 60rpx -34rpx rgba(16,66,74,.5), inset 0 1rpx 0 rgba(255,255,255,.9)}
