<app-header title="法律凭证" back="{{true}}" fallback="/pages/admin/index" />
<view class="admin-page">
  <view class="admin-head">
    <view class="admin-sub">点「看图」核验执业证；通过后对方才能接法律工单。图片为私有存储，仅审核员可读。</view>
  </view>

  <view wx:if="{{loading}}" class="admin-group"><view class="empty">正在读取…</view></view>
  <view wx:elif="{{error}}" class="admin-group"><view class="empty">{{error}}</view></view>
  <view wx:elif="{{!items.length}}" class="admin-group"><view class="empty">没有待核验的凭证。</view></view>

  <view wx:else class="admin-group">
    <view wx:for="{{items}}" wx:key="id" class="admin-row admin-row-stack">
      <view class="admin-row-main">
        <view class="admin-row-title">{{item.display_name}}<text class="admin-tag">{{item.kindText}}</text></view>
        <view class="admin-row-detail">{{item.user_id}} · 提交于 {{item.timeText}}</view>
      </view>
      <view class="admin-actions">
        <button class="admin-btn small" data-id="{{item.id}}" bindtap="view">看图</button>
        <button class="admin-btn small approve" data-id="{{item.id}}" data-decision="approve" bindtap="review" disabled="{{busy}}">通过</button>
        <button class="admin-btn small danger" data-id="{{item.id}}" data-decision="reject" bindtap="review" disabled="{{busy}}">拒绝</button>
      </view>
    </view>
  </view>
</view>
