/* 管理台共用样式：各子页面用 @import "../../admin.wxss"; 引入。 */
.admin-page { min-height: 100vh; padding: 24rpx 28rpx 60rpx; box-sizing: border-box; background: #F3F8F9; }
.admin-head { padding: 8rpx 4rpx 20rpx; }
.admin-title { font-size: 34rpx; font-weight: 600; color: #17343A; }
.admin-sub { margin-top: 8rpx; font-size: 23rpx; line-height: 1.6; color: #5B737A; }
.admin-group { margin-top: 12rpx; padding: 8rpx 24rpx; border-radius: 20rpx; background: #FFFFFF; }
.admin-group-title { padding: 18rpx 0 6rpx; font-size: 22rpx; letter-spacing: 1rpx; color: #7A8F95; }
.admin-row { display: flex; align-items: center; padding: 20rpx 0; border-top: 2rpx solid #EDF3F4; }
.admin-row:first-of-type { border-top: none; }
.admin-row-main { flex: 1; min-width: 0; }
.admin-row-title { font-size: 27rpx; color: #1F3B42; }
.admin-row-detail { margin-top: 6rpx; font-size: 22rpx; line-height: 1.5; color: #6B8288; word-break: break-all; }
.admin-row-stage { flex: none; margin-left: 16rpx; padding: 4rpx 14rpx; border-radius: 20rpx; background: #E4F4EE; color: #0A5A61; font-size: 20rpx; }
.admin-actions { display: flex; flex-direction: row; gap: 12rpx; margin-top: 14rpx; }
.admin-btn { margin: 0; flex: 1; padding: 0; height: 56rpx; line-height: 56rpx; font-size: 22rpx; border-radius: 12rpx; background: #F1F7F7; color: #51686F; border: 2rpx solid #DCEAEC; }
.admin-btn::after { border: none; }
.admin-btn.approve { background: #0E7C86; color: #fff; border-color: #0E7C86; }
.admin-btn.danger { color: #B44B3C; border-color: #E8C9C3; background: #FBF2F0; }
.admin-btn.small { flex: 1; height: 52rpx; line-height: 52rpx; font-size: 21rpx; }
.admin-row-stack { flex-direction: column; align-items: stretch; }
.admin-tag { margin-left: 10rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: #E4F4EE; color: #0A5A61; font-size: 19rpx; }
.admin-note { margin-top: 22rpx; padding: 0 6rpx; font-size: 21rpx; line-height: 1.6; color: #7A8F95; }
.stat-row { display: flex; gap: 12rpx; margin: 6rpx 0 4rpx; }
.stat { flex: 1; padding: 18rpx 0; border-radius: 18rpx; background: #FFFFFF; text-align: center; }
.stat-num { display: block; font-size: 34rpx; font-weight: 600; color: #0A5A61; }
.stat-label { display: block; margin-top: 4rpx; font-size: 20rpx; color: #7A8F95; }
.entry-row { display: flex; align-items: center; padding: 26rpx 4rpx; border-top: 2rpx solid #EDF3F4; }
.entry-row:first-of-type { border-top: none; }
.entry-icon { flex: none; width: 64rpx; height: 64rpx; margin-right: 18rpx; border-radius: 16rpx; background: #E4F4EE; }
.entry-copy { flex: 1; min-width: 0; }
.entry-title { font-size: 28rpx; color: #1F3B42; }
.entry-detail { margin-top: 4rpx; font-size: 21rpx; color: #7A8F95; }
.entry-arrow { flex: none; margin-left: 12rpx; font-size: 24rpx; color: #A9BCC0; }
.empty { padding: 28rpx 0; font-size: 22rpx; color: #7A8F95; }
