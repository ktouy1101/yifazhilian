/* 审核工作台：与患者端同一套视觉（浅底、白卡、青色主色、分段控件） */
.shell-page{min-height:100vh;background:#F3F8F9;padding:0 28rpx;box-sizing:border-box}
.shell-hero{padding:20rpx 4rpx 18rpx}
.hero-name{font-size:40rpx;font-weight:700;color:#173D46;line-height:1.35}
.hero-sub{margin-top:10rpx;font-size:23rpx;line-height:1.7;color:#51686F}

.shell-card{padding:26rpx;margin-bottom:20rpx;border-radius:30rpx;background:#FFFFFF;box-shadow:0 6rpx 18rpx rgba(16,66,74,.05)}
.card-title{font-size:25rpx;font-weight:600;color:#7A8F95;margin-bottom:8rpx}
.shell-empty{padding:26rpx 0;font-size:23rpx;line-height:1.7;color:#7A8F95}

.item{display:flex;align-items:center;gap:12rpx;padding:20rpx 0;border-top:1rpx solid #EDF3F4;flex-wrap:wrap}
.item:first-of-type{border-top:none}
.item-main{flex:1;min-width:0}
.item-title{font-size:27rpx;color:#21424A;font-weight:600}
.item-desc{margin-top:6rpx;font-size:22rpx;line-height:1.6;color:#617B82;word-break:break-all}
.item-tag{margin-left:10rpx;padding:4rpx 12rpx;border-radius:16rpx;background:#EDF7F6;color:#0A5A61;font-size:20rpx;font-weight:400}
.item-arrow{font-size:26rpx;color:#A9BCC0}
.item-btn{flex:none;margin:0;padding:0 22rpx;height:56rpx;line-height:56rpx;border-radius:28rpx;background:#F1F7F7;color:#51686F;font-size:22rpx;border:2rpx solid #DCEAEC}
.item-btn.ok{background:#0E7C86;color:#fff;border-color:#0E7C86}
.item-btn::after{border:none}

/* 凭证这类需要多个按钮的行：文字一行，按钮另起一行 */
.item-stack{flex-direction:column;align-items:stretch}
.item-actions{display:flex;gap:12rpx;margin-top:12rpx}
.item-actions .item-btn{flex:1;text-align:center}

.big-entry{display:flex;align-items:center;gap:16rpx;padding:22rpx 0;border-top:1rpx solid #EDF3F4}
.big-entry:first-of-type{border-top:none}
.big-icon{flex:none;width:56rpx;height:56rpx;border-radius:18rpx;background:#EDF7F6;color:#0A5A61;font-size:24rpx;display:flex;align-items:center;justify-content:center}
.big-copy{flex:1;min-width:0}
.big-title{font-size:27rpx;color:#21424A}
.big-desc{margin-top:4rpx;font-size:22rpx;color:#7A8F95}
.big-arrow{font-size:26rpx;color:#A9BCC0}

/* 用户页：分段控件与白色卡片，和患者端「用药计划 / 健康状况」一致 */
.seg{display:flex;gap:6rpx;background:#E6EFF0;padding:8rpx;border-radius:28rpx;margin-bottom:18rpx}
.seg-item{flex:1;display:flex;align-items:center;justify-content:center;gap:6rpx;padding:14rpx 4rpx;border-radius:23rpx;font-size:22rpx;color:#51686F;transition:background .2s ease,color .2s ease}
.seg-item.on{background:#fff;color:#0E7C86;font-weight:700;box-shadow:0 5rpx 15rpx rgba(16,66,74,.07)}
.seg-count{font-size:18rpx;color:#8AA0A6}
.seg-item.on .seg-count{color:#0E7C86}

.person{display:flex;gap:16rpx;padding:22rpx 0;border-top:1rpx solid #EDF3F4}
.person:first-of-type{border-top:none}
.avatar{flex:none;width:72rpx;height:72rpx;border-radius:24rpx;background:#EDF7F6;color:#0E7C86;font-size:28rpx;font-weight:700;display:flex;align-items:center;justify-content:center}
.person-main{flex:1;min-width:0}
.person-name{font-size:27rpx;font-weight:600;color:#21424A}
.person-tag{margin-left:10rpx;padding:4rpx 12rpx;border-radius:16rpx;font-size:19rpx;background:#EDF3F4;color:#617B82;font-weight:400}
.person-tag.vol{background:#EDF7F6;color:#0A5A61}
.person-tag.rev{background:#EDF4F8;color:#2B6A86}
.person-tag.demo{background:#FCF2E2;color:#94612D}
.person-sub{margin-top:6rpx;font-size:21rpx;color:#7A8F95}
.person-actions{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx}
.person-btn{margin:0;padding:0 20rpx;height:54rpx;line-height:54rpx;border-radius:27rpx;background:#F1F7F7;color:#51686F;font-size:21rpx;border:2rpx solid #DCEAEC}
.person-btn::after{border:none}
.person-btn.danger{background:#FBF2F0;color:#A14E45;border-color:#E8C9C3}

.shell-error{font-size:23rpx;color:#A14E45}
.shell-gap{height:150rpx}

/* 工作台玻璃风 + 动效（2026-11-07） */
.hero{
  background:rgba(255,255,255,.58);
  -webkit-backdrop-filter:blur(28rpx) saturate(180%); backdrop-filter:blur(28rpx) saturate(180%);
  border:1rpx solid rgba(255,255,255,.78); border-radius:32rpx;
  padding:26rpx 28rpx; margin-bottom:22rpx;
  box-shadow:0 20rpx 54rpx -32rpx rgba(16,66,74,.5), inset 0 1rpx 0 rgba(255,255,255,.9)}
.big-entry{
  background:rgba(255,255,255,.6);
  -webkit-backdrop-filter:blur(24rpx); backdrop-filter:blur(24rpx);
  border:1rpx solid rgba(255,255,255,.78); border-radius:30rpx;
  box-shadow:0 18rpx 48rpx -32rpx rgba(16,66,74,.45);
  transition:transform .16s ease, box-shadow .2s ease}
.big-entry:active{transform:scale(.975)}
@keyframes wb-rise{from{opacity:0;transform:translateY(16rpx)}to{opacity:1;transform:none}}
.item,.big-entry,.hero{animation:wb-rise .34s cubic-bezier(.22,.61,.36,1) both}
.item:nth-of-type(2){animation-delay:.04s}
.item:nth-of-type(3){animation-delay:.08s}
.item:nth-of-type(4){animation-delay:.12s}
