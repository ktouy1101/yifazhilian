<app-header title="管理台" back="{{true}}" fallback="/pages/profile/index" />
<view class="admin-page">
  <view class="admin-head">
    <view class="admin-title">审核员 · {{me && me.display_name ? me.display_name : '管理员'}}</view>
    <view class="admin-sub">所有动作由服务端校验；这里只是入口。</view>
  </view>

  <view class="stat-row">
    <view class="stat"><text class="stat-num">{{overview.routes_pending}}</text><text class="stat-label">路线待审</text></view>
    <view class="stat"><text class="stat-num">{{overview.volunteers_pending}}</text><text class="stat-label">志愿者待审</text></view>
    <view class="stat"><text class="stat-num">{{overview.feedback_total}}</text><text class="stat-label">反馈</text></view>
    <view class="stat"><text class="stat-num">{{overview.users_total}}</text><text class="stat-label">用户</text></view>
  </view>

  <view class="admin-group">
    <view class="entry-row" data-url="/pages/admin/routes/index" bindtap="open">
      <view class="entry-copy">
        <view class="entry-title">路线审核</view>
        <view class="entry-detail">{{overview.routes_pending}} 条待审 · {{overview.routes_published}} 条已发布</view>
      </view>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry-row" data-url="/pages/admin/volunteers/index" bindtap="open">
      <view class="entry-copy">
        <view class="entry-title">志愿者申请</view>
        <view class="entry-detail">{{overview.volunteers_pending}} 条待审 · 通过后开放采集权限</view>
      </view>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry-row" data-url="/pages/admin/feedback/index" bindtap="open">
      <view class="entry-copy">
        <view class="entry-title">导航反馈</view>
        <view class="entry-detail">{{overview.feedback_total}} 条反馈</view>
      </view>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry-row" data-url="/pages/admin/credentials/index" bindtap="open">
      <view class="entry-copy">
        <view class="entry-title">法律凭证</view>
        <view class="entry-detail">{{overview.credentials_pending}} 份待核验 · 通过后才能接法律工单</view>
      </view>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry-row" data-url="/pages/admin/legal-help/index" bindtap="open">
      <view class="entry-copy">
        <view class="entry-title">法律工单</view>
        <view class="entry-detail">{{overview.help_open}} 个进行中</view>
      </view>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry-row" data-url="/pages/admin/users/index" bindtap="open">
      <view class="entry-copy">
        <view class="entry-title">用户管理</view>
        <view class="entry-detail">{{overview.users_total}} 个账号 · 角色与停用</view>
      </view>
      <text class="entry-arrow">›</text>
    </view>
    <view class="entry-row" data-url="/pages/admin/audit/index" bindtap="open">
      <view class="entry-copy">
        <view class="entry-title">审计</view>
        <view class="entry-detail">最近的审核与授权动作</view>
      </view>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <view class="admin-note">法律凭证通过后，对方才能接法律工单；工单只传问题文本，不含病历与手机号。</view>
</view>
