<app-header title="管理台" back="{{true}}" fallback="/pages/profile/index" />
<view class="admin-page">
  <view class="admin-head">
    <view class="admin-title">审核员 · {{me && me.display_name ? me.display_name : '管理员'}}</view>
    <view class="admin-sub">待办与审核动作都在服务端校验；本页只展示入口。</view>
  </view>

  <view class="admin-group">
    <view class="admin-group-title">志愿者申请 · 待审核 {{volunteers.length}}</view>
    <view wx:if="{{volunteersError}}" class="admin-row-detail">{{volunteersError}}</view>
    <view wx:if="{{!volunteers.length && !volunteersError}}" class="admin-row-detail">没有待审核的申请。</view>
    <view wx:for="{{volunteers}}" wx:key="user_id" class="admin-row admin-row-stack">
      <view class="admin-row-main">
        <view class="admin-row-title">{{item.real_name}} · {{item.display_name}}</view>
        <view class="admin-row-detail">医院 {{item.hospital_id}} · 提交于 {{item.updated_at}}</view>
      </view>
      <view class="admin-actions">
        <button class="admin-btn approve" data-id="{{item.user_id}}" data-decision="approve" bindtap="reviewVolunteer">通过</button>
        <button class="admin-btn reject" data-id="{{item.user_id}}" data-decision="reject" bindtap="reviewVolunteer">拒绝</button>
      </view>
    </view>
  </view>

  <view class="admin-group">
    <view class="admin-group-title">待办</view>
    <view wx:for="{{pending}}" wx:key="key" class="admin-row">
      <view class="admin-row-main">
        <view class="admin-row-title">{{item.title}}</view>
        <view class="admin-row-detail">{{item.detail}}</view>
      </view>
      <text class="admin-row-stage">{{item.stage}}</text>
    </view>
  </view>

  <view class="admin-note">P2 已接入：志愿者申请可通过/拒绝，通过后自动获得采集权限；路线审核与反馈处理在 P3 接入。</view>
</view>
