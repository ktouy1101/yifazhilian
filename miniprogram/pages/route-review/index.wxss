.review-node { padding:18rpx 0; border-bottom:1rpx solid #E2ECEE; }
.review-node:last-child { border-bottom:0; }
.rn-head { display:flex; align-items:center; gap:14rpx; margin-bottom:8rpx; }
.rn-index { width:36rpx; height:36rpx; border-radius:50%; background:#0E7C86; color:#fff; text-align:center; line-height:36rpx; font-size:22rpx; }
.rn-kind { font-weight:600; font-size:26rpx; }
.rn-floor { color:#8AA0A6; font-size:22rpx; margin-left:auto; }
.rn-desc { color:#51686F; font-size:25rpx; margin-bottom:10rpx; }
.rn-photo { width:200rpx; height:200rpx; border-radius:16rpx; background:#E2ECEE; }
.rn-nophoto { color:#8AA0A6; font-size:22rpx; padding:30rpx 0; }
.field-label { font-size:24rpx; color:#51686F; margin:16rpx 0 8rpx; }
.note { background:#F3F8F9; border-radius:18rpx; padding:18rpx; width:100%; min-height:120rpx; font-size:25rpx; }
.agree { display:flex; align-items:flex-start; gap:10rpx; font-size:24rpx; color:#51686F; margin-top:18rpx; }
.actions { display:flex; gap:18rpx; margin-top:24rpx; }
.actions button { flex:1; }
.chips { display:flex; flex-wrap:wrap; gap:12rpx; margin:10rpx 0 16rpx; }
.empty { color:#8AA0A6; font-size:25rpx; padding:16rpx 0; }
.err { color:#A33229; font-size:26rpx; margin:16rpx 0; }
.outline-button { color:#0E7C86; font-size:26rpx; margin:12rpx 0; background:#EDF8F8; border-radius:16rpx; }
.note { box-sizing:border-box; margin:18rpx 0; }
.start-card .rn-desc { margin-top:16rpx; }
.public-route .rn-photo { width:100%; height:380rpx; }
.public-route button.start-button { display:flex; width:100%; margin-top:24rpx; border-radius:24rpx; }
