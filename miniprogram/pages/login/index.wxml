<app-header title="{{joinVolunteer ? '志愿者注册' : '手机号登录'}}" back="{{true}}" fallback="/pages/profile/index" />
<view class="login-page {{joinVolunteer ? 'vol-mode' : ''}}">
  <view class="brand {{joinVolunteer ? 'brand-vol' : 'brand-normal'}}">
    <block wx:if="{{joinVolunteer}}">
      <view class="brand-logo vol">愿</view>
      <view class="brand-name">志愿者注册</view>
      <view class="brand-sub">先登录，再提交申请；通过后可做导诊采集或法律帮扶</view>
    </block>
    <block wx:else>
      <image class="brand-mark" src="/assets/brand/logo-penguin.png" mode="aspectFit" />
      <view class="brand-name">小企鹅医法智联</view>
      <view class="brand-sub">健康与法律知识科普</view>
    </block>
  </view>

  <view class="form-card {{joinVolunteer ? 'vol' : ''}}">
    <view class="mode-switch">
      <view class="mode-item {{mode === 'code' ? 'on' : ''}}" data-mode="code" bindtap="switchMode">验证码登录</view>
      <view class="mode-item {{mode === 'password' ? 'on' : ''}}" data-mode="password" bindtap="switchMode">密码登录</view>
    </view>

    <view class="field">
      <text class="field-label">手机号</text>
      <input class="field-input" type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" placeholder="请输入手机号" />
    </view>

    <view wx:if="{{mode === 'code'}}" class="field">
      <text class="field-label">验证码</text>
      <view class="code-row">
        <input class="field-input code-input" type="number" maxlength="6" value="{{code}}" bindinput="onCode" placeholder="6 位验证码" />
        <button class="code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendCode" disabled="{{countdown > 0 || sending}}">
          {{countdown > 0 ? countdown + 's' : '获取'}}
        </button>
      </view>
    </view>

    <view wx:else class="field">
      <text class="field-label">密码</text>
      <input class="field-input" password value="{{password}}" bindinput="onPassword" maxlength="64" placeholder="请输入密码" />
    </view>

    <button class="login-btn" bindtap="login" disabled="{{loading}}" loading="{{loading}}">
      {{mode === 'password' ? '登录' : (joinVolunteer ? '登录并继续申请' : '登录 / 注册')}}
    </button>
    <view class="tip-row">
      <text class="tip">{{mode === 'password' ? '忘记密码请联系管理员重置' : (joinVolunteer ? '登录后进入志愿者中心填写申请' : '未注册的手机号将自动创建账号')}}</text>
      <view class="join-link {{joinVolunteer ? 'on' : ''}}" bindtap="joinAsVolunteer" hover-class="join-pressed">
        <text class="join-check">✓</text>
        <text class="join-text">{{joinVolunteer ? '返回普通登录' : '成为志愿者'}}</text>
        <text class="join-arrow">{{joinVolunteer ? '‹' : '›'}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{recentAccounts.length > 0}}" class="recent">
    <view class="recent-title">最近登录</view>
    <view wx:for="{{recentAccounts}}" wx:key="phone" class="recent-row" bindtap="useRecent" data-phone="{{item.phone}}">
      <text class="recent-phone">{{item.phone}}</text>
      <text class="recent-label">切换 ›</text>
    </view>
  </view>
</view>
