.topbar { display:flex; align-items:baseline; justify-content:space-between; margin-bottom:14rpx; }
.route-title { font-size:32rpx; font-weight:700; }
.progress { color:#51686F; font-size:24rpx; flex-shrink:0; }
.progress-bar { height:8rpx; background:#E2ECEE; border-radius:8rpx; overflow:hidden; margin-bottom:24rpx; }
.progress-fill { height:100%; background:#0E7C86; transition:width .2s; }
.stage { background:#fff; border-radius:32rpx; padding:24rpx; box-shadow:0 16rpx 48rpx -34rpx rgba(16,66,74,.35); }
.photo { width:100%; height:480rpx; border-radius:24rpx; background:#E2ECEE; }
.photo.placeholder { display:flex; align-items:center; justify-content:center; color:#8AA0A6; font-size:24rpx; }
.chip-row { display:flex; gap:12rpx; flex-wrap:wrap; margin:20rpx 0 12rpx; }
.chip { padding:6rpx 18rpx; border-radius:30rpx; background:#F3F8F9; color:#51686F; font-size:22rpx; }
.chip.med { background:#E2F2F3; color:#0A5A61; }
.chip.warm { background:#FCEEE6; color:#C9613C; }
.desc { font-size:28rpx; line-height:1.6; }
.controls { display:flex; gap:18rpx; margin-top:28rpx; }
.controls button:first-child { flex:0 0 160rpx; }
.controls button:last-child { flex:1; }
.step-prompt { color:#0A5A61; font-size:28rpx; font-weight:600; margin-bottom:20rpx; }
.photo-hint { color:#51686F; font-size:23rpx; margin-top:10rpx; }
.walkthrough-note { color:#51686F; font-size:24rpx; line-height:1.7; margin-top:24rpx; }
.walkthrough button.return-route { margin-top:20rpx; }
.btn.ok { background:linear-gradient(135deg,#3FA67A,#2C7A59); box-shadow:0 20rpx 40rpx -22rpx #3FA67A; }
.btn.ghost { background:#fff; color:#132930; box-shadow:0 0 0 2rpx #E2ECEE; }
