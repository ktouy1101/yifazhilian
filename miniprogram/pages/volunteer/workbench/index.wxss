/* 志愿者工作台：沿用患者端的浅底 + 白色圆角卡片 + 青色主色 */
.shell-page{min-height:100vh;background:#F3F8F9;padding:0 28rpx;box-sizing:border-box}
.shell-hero{padding:20rpx 4rpx 18rpx}
.hero-name{font-size:40rpx;font-weight:700;color:#173D46;line-height:1.35}
.hero-badges{display:flex;gap:10rpx;margin-top:12rpx}
.hero-badge{padding:7rpx 17rpx;border-radius:30rpx;background:#EDF7F6;color:#36747B;font-size:21rpx;border:1rpx solid #C4E1E2}
.hero-badge.legal{background:#EDF4F8;color:#2B6A86;border-color:#C9DEE9}
.hero-badge.wait{background:#FCF2E2;color:#94612D;border-color:#F0DCC0}
.hero-sub{margin-top:12rpx;font-size:23rpx;line-height:1.7;color:#51686F}

.stat-row{display:flex;gap:12rpx;margin-bottom:18rpx}
.stat-card{flex:1;padding:24rpx 12rpx;border-radius:28rpx;background:#FFFFFF;display:flex;flex-direction:column;align-items:center;gap:6rpx;box-shadow:0 6rpx 18rpx rgba(16,66,74,.05)}
.stat-num{font-size:44rpx;font-weight:800;color:#0E7C86;line-height:1.1}
.stat-label{font-size:21rpx;color:#617B82}
.stat-card.alert{background:#FBF2F0}
.stat-card.alert .stat-num{color:#A14E45}

.shell-card{padding:26rpx;margin-bottom:20rpx;border-radius:30rpx;background:#FFFFFF;box-shadow:0 6rpx 18rpx rgba(16,66,74,.05)}
.card-title{font-size:25rpx;font-weight:600;color:#7A8F95;margin-bottom:8rpx}
.shell-empty{padding:26rpx 0;font-size:23rpx;line-height:1.7;color:#7A8F95}

.row{display:flex;align-items:center;gap:14rpx;padding:20rpx 0;border-top:1rpx solid #EDF3F4}
.row:first-of-type{border-top:none}
.row-main{flex:1;min-width:0}
.row-title{font-size:27rpx;color:#21424A;font-weight:600}
.row-desc{margin-top:6rpx;font-size:22rpx;line-height:1.6;color:#617B82;word-break:break-all}
.row-arrow{flex:none;font-size:26rpx;color:#A9BCC0}
.row-btn{flex:none;margin:0;padding:0 26rpx;height:62rpx;line-height:62rpx;border-radius:31rpx;background:#0E7C86;color:#fff;font-size:23rpx}
.row-btn::after{border:none}
.row-tag{flex:none;margin-left:10rpx;padding:5rpx 14rpx;border-radius:18rpx;background:#EDF7F6;color:#0A5A61;font-size:20rpx}
.row-tag.wait{background:#FCF2E2;color:#94612D}

.quick{display:flex;align-items:center;gap:16rpx;padding:22rpx 0;border-top:1rpx solid #EDF3F4}
.quick:first-of-type{border-top:none}
.quick-icon{width:56rpx;height:56rpx;border-radius:18rpx;background:#EDF7F6;color:#0A5A61;font-size:24rpx;display:flex;align-items:center;justify-content:center;flex:none}
.quick-copy{flex:1;min-width:0}
.quick-title{font-size:27rpx;color:#21424A}
.quick-desc{margin-top:4rpx;font-size:22rpx;color:#7A8F95}
.quick-arrow{font-size:26rpx;color:#A9BCC0}

.info-row{display:flex;justify-content:space-between;padding:18rpx 0;border-top:1rpx solid #EDF3F4;font-size:24rpx}
.info-row:first-of-type{border-top:none}
.info-label{color:#7A8F95}
.info-value{color:#21424A;font-weight:500}

.shell-error{font-size:23rpx;color:#A14E45}
.alert-text{color:#A14E45}
.wide-btn{width:100%;margin-top:18rpx;border-radius:22rpx;background:linear-gradient(135deg,#0E7C86,#0A5A61);color:#fff;font-size:28rpx;font-weight:600;line-height:92rpx;padding:0}
.wide-btn::after{border:none}
.shell-gap{height:150rpx}
