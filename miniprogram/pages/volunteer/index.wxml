<app-header title="志愿者中心" back="{{true}}" fallback="/pages/profile/index" />
<view class="vol-page">
  <view wx:if="{{loading}}" class="vol-card">正在读取…</view>

  <view wx:elif="{{status === 'guest'}}" class="vol-card">
    <view class="vol-card-title">还没有登录</view>
    <view class="vol-text">登录后才能申请志愿者、上传凭证和接单。</view>
    <button class="vol-btn" bindtap="openLogin">去登录</button>
  </view>

  <block wx:else>
    <view class="vol-head">
      <view class="vol-title">
        志愿者
        <text class="vol-badge {{status === 'approved' ? '' : status === 'pending' ? 'wait' : status === 'rejected' || status === 'suspended' ? 'bad' : 'wait'}}">
          {{status === 'approved' ? '已通过' : status === 'pending' ? '审核中' : status === 'rejected' ? '未通过' : status === 'suspended' ? '已暂停' : '未申请'}}
        </text>
      </view>
      <view class="vol-sub">
        {{status === 'approved' ? '可以做导诊采集与法律帮扶；两项能力分别由不同审核决定。' : status === 'pending' ? '审核员核对后会开放能力。' : status === 'rejected' ? '可以修改资料重新提交。' : status === 'suspended' ? '请联系审核员恢复。' : '先提交申请，填写真实姓名与培训确认。'}}
      </view>
    </view>

    <view class="vol-card" style="padding: 8rpx 24rpx;">
      <view class="vol-entry" data-url="/pages/volunteer/application/index" bindtap="open">
        <view class="vol-entry-copy">
          <view class="vol-entry-title">志愿者申请</view>
          <view class="vol-entry-detail">
            {{status === 'none' ? '还没有提交申请' : status === 'pending' ? '等待审核中' : status === 'approved' ? '已通过 · 查看资料' : '查看状态与审核意见'}}
          </view>
        </view>
        <text class="vol-entry-arrow">›</text>
      </view>

      <view wx:if="{{caps.can_collect}}" class="vol-entry" bindtap="openWorkbench">
        <view class="vol-entry-copy">
          <view class="vol-entry-title">导航采集</view>
          <view class="vol-entry-detail">领取任务、拍照、提交审核</view>
        </view>
        <text class="vol-entry-arrow">›</text>
      </view>

      <view class="vol-entry" data-url="/pages/volunteer/legal/index" bindtap="open">
        <view class="vol-entry-copy">
          <view class="vol-entry-title">法律帮扶</view>
          <view class="vol-entry-detail">
            {{caps.can_help_legal ? '凭证已核验 · 可以接工单' : credentials.length ? '凭证待核验' : '未上传执业证'}}
          </view>
        </view>
        <text class="vol-entry-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{error}}" class="vol-error">{{error}}</view>
  </block>
</view>
