/* 志愿者中心共用样式：子页面用 @import "../volunteer.wxss"; 引入。 */
.vol-page { min-height: 100vh; padding: 24rpx 28rpx 60rpx; box-sizing: border-box; background: #F3F8F9; }
.vol-head { padding: 8rpx 4rpx 18rpx; }
.vol-title { font-size: 34rpx; font-weight: 600; color: #17343A; }
.vol-sub { margin-top: 8rpx; font-size: 23rpx; line-height: 1.6; color: #5B737A; }
.vol-card { margin-top: 12rpx; padding: 24rpx; border-radius: 20rpx; background: #FFFFFF; }
.vol-card-title { font-size: 27rpx; font-weight: 600; color: #1F3B42; }
.vol-text { margin-top: 8rpx; font-size: 23rpx; line-height: 1.65; color: #5B737A; }
.vol-note { margin-top: 10rpx; font-size: 21rpx; color: #7A8F95; }
.vol-badge { display: inline-block; margin-left: 10rpx; padding: 2rpx 10rpx; border-radius: 8rpx; font-size: 19rpx; background: #E4F4EE; color: #0A5A61; }
.vol-badge.wait { background: #FFF3E2; color: #A66A1E; }
.vol-badge.bad { background: #FBF2F0; color: #B44B3C; }
.vol-entry { display: flex; align-items: center; padding: 26rpx 4rpx; border-top: 2rpx solid #EDF3F4; }
.vol-entry:first-of-type { border-top: none; }
.vol-entry-copy { flex: 1; min-width: 0; }
.vol-entry-title { font-size: 28rpx; color: #1F3B42; }
.vol-entry-detail { margin-top: 4rpx; font-size: 21rpx; color: #7A8F95; }
.vol-entry-arrow { flex: none; margin-left: 12rpx; font-size: 24rpx; color: #A9BCC0; }
.vol-btn { width: 100%; margin-top: 18rpx; border-radius: 18rpx; background: linear-gradient(135deg, #0E7C86, #0A5A61); color: #fff; font-size: 28rpx; font-weight: 600; line-height: 88rpx; padding: 0; }
.vol-btn::after { border: none; }
.vol-btn.ghost { background: #F1F7F7; color: #51686F; border: 2rpx solid #DCEAEC; }
.vol-field { margin-top: 18rpx; }
.vol-label { font-size: 22rpx; color: #7A8F95; }
.vol-input { margin-top: 8rpx; background: #F2F7F8; border-radius: 14rpx; padding: 0 22rpx; height: 80rpx; line-height: 80rpx; font-size: 27rpx; }
.vol-error { margin-top: 14rpx; font-size: 22rpx; color: #B44B3C; }
