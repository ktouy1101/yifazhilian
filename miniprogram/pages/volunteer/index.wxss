.volunteer-page { min-height: 100vh; padding: 24rpx 28rpx 60rpx; box-sizing: border-box; background: #F3F8F9; }
.tip-card { padding: 40rpx 32rpx; border-radius: 20rpx; background: #FFFFFF; text-align: center; }
.tip-title { font-size: 30rpx; color: #17343A; }
.tip-text { margin-top: 12rpx; font-size: 23rpx; line-height: 1.6; color: #5B737A; }
.status-card { padding: 26rpx 28rpx; border-radius: 20rpx; background: #FFFFFF; border-left: 8rpx solid #C3D5D8; }
.status-pending { border-left-color: #E0A63B; }
.status-approved { border-left-color: #0E7C86; }
.status-rejected { border-left-color: #C25A4A; }
.status-title { font-size: 30rpx; font-weight: 600; color: #17343A; }
.status-text { margin-top: 10rpx; font-size: 23rpx; line-height: 1.6; color: #5B737A; }
.status-note { margin-top: 12rpx; font-size: 22rpx; color: #8A6A2A; }
.primary-btn { width: 100%; margin-top: 22rpx; border-radius: 18rpx; background: linear-gradient(135deg, #0E7C86, #0A5A61); color: #fff; font-size: 28rpx; font-weight: 600; line-height: 92rpx; padding: 0; }
.primary-btn::after { border: none; }
.primary-btn[disabled] { opacity: .6; }
.form-card { margin-top: 22rpx; padding: 28rpx 26rpx; border-radius: 20rpx; background: #FFFFFF; }
.form-title { font-size: 26rpx; font-weight: 600; color: #17343A; margin-bottom: 18rpx; }
.field { margin-bottom: 22rpx; }
.field-label { display: block; font-size: 22rpx; color: #51686F; margin-bottom: 10rpx; }
.field-input { background: #F2F7F8; border-radius: 14rpx; padding: 0 22rpx; height: 82rpx; line-height: 82rpx; font-size: 27rpx; }
.check-row { display: flex; align-items: flex-start; gap: 14rpx; }
.check-text { flex: 1; font-size: 22rpx; line-height: 1.6; color: #51686F; }
.error-text { margin-top: 18rpx; font-size: 22rpx; color: #C25A4A; }
