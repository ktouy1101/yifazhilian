.review-page { padding-bottom:60rpx; }.steps { display:flex; justify-content:space-between; align-items:center; font-size:23rpx; color:#637B82; margin:8rpx 0 26rpx; }.steps .current { color:#0A5A61; font-weight:700; }.feedback { padding:22rpx 26rpx; margin-bottom:22rpx; border-radius:22rpx; font-size:25rpx; }.error { background:#FCE9E7; color:#A9342B; }.notice { background:#E2F2F3; color:#0A5A61; }
.archive-guide { padding:24rpx; margin:20rpx 0; border-radius:24rpx; background:#FFF3E7; color:#784923; }.archive-guide.ready { background:#E2F2F3; color:#0A5A61; }.guide-title { font-size:27rpx; font-weight:600; }.review-step { display:flex; align-items:center; gap:20rpx; width:100%; padding:20rpx 0 4rpx; font-size:24rpx; line-height:1.6; text-align:left; white-space:normal; color:#784923; }.review-step>text:first-child { flex:1; min-width:0; }.step-arrow { flex-shrink:0; color:#0A5A61; }.retry-extraction { margin-top:24rpx; }
.photo-actions { display:flex; gap:16rpx; }.photo-actions button { flex:1; min-width:0; padding:22rpx 12rpx; font-size:26rpx; }.photo-actions image { width:32rpx; height:32rpx; flex-shrink:0; }.upload-note { margin-top:24rpx; font-size:23rpx; color:#637B82; }.agree text { flex:1; min-width:0; white-space:normal; word-break:break-all; }
.tip { margin:18rpx 0; }.empty-photo { padding:80rpx 20rpx; text-align:center; color:#637B82; }.pending-image { width:100%; height:500rpx; background:#F3F8F9; border-radius:20rpx; margin:10rpx 0 20rpx; }.agree { display:flex; align-items:flex-start; gap:8rpx; margin:22rpx 0; color:#51686F; font-size:25rpx; }.agree checkbox { flex-shrink:0; }.status-row { display:flex; align-items:center; justify-content:space-between; margin-bottom:16rpx; }
.source-head { display:flex; align-items:center; justify-content:space-between; }.source-head button,.locate { color:#0E7C86; font-size:24rpx; }.source-image { width:100%; height:340rpx; background:#EDF3F4; border-radius:20rpx; margin:20rpx 0 10rpx; }.source-caption { font-size:22rpx; color:#637B82; }.crop-panel { padding:16rpx 0; color:#0A5A61; font-size:24rpx; }.crop { width:100%; margin-top:10rpx; border:2rpx solid #0E7C86; border-radius:12rpx; }.actions { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:24rpx; }
.section-title .tiny { margin-left:auto; font-weight:400; }.field-label { font-size:24rpx; color:#51686F; margin:20rpx 0 8rpx; }.field-input { width:100%; min-width:0; height:82rpx; background:#F3F8F9; border-radius:16rpx; padding:18rpx 20rpx; font-size:28rpx; }.two-columns { display:flex; gap:18rpx; }.two-columns>view { flex:1; min-width:0; }.result-value { font-size:32rpx; font-weight:600; }.section-header { display:flex; justify-content:space-between; align-items:center; margin:32rpx 0 20rpx; }.result-head { display:flex; align-items:center; gap:12rpx; }.row-number { width:42rpx; height:42rpx; border-radius:50%; text-align:center; background:#E2F2F3; color:#0A5A61; line-height:42rpx; }.result-head .locate { margin-left:auto; }.attention { font-size:22rpx; color:#A05D27; }.low-confidence { border:2rpx solid #E8B58E; }.original-value { margin-top:18rpx; font-size:23rpx; color:#637B82; background:#F3F8F9; padding:14rpx 18rpx; border-radius:12rpx; overflow-wrap:anywhere; }.result-footer { display:flex; align-items:center; justify-content:space-between; gap:10rpx; }.result-footer .agree { font-size:24rpx; margin-bottom:0; }.remove { color:#A9342B; font-size:24rpx; padding-top:20rpx; }
button.full { width:100%; }.add-field { margin:6rpx 0 26rpx; }.fold { width:100%; text-align:left; font-size:27rpx; font-weight:600; display:flex; justify-content:space-between; }.fold text { color:#0E7C86; font-size:23rpx; font-weight:400; }.raw-line { padding:10rpx 0; border-bottom:1rpx solid #E2ECEE; font-size:24rpx; overflow-wrap:anywhere; }.history-link { display:block; width:100%; text-align:left; padding:20rpx 0; border-bottom:1rpx solid #E2ECEE; font-size:24rpx; overflow-wrap:anywhere; }.change { padding:12rpx 0; border-bottom:1rpx solid #E2ECEE; overflow-wrap:anywhere; }.before { color:#A9342B; text-decoration:line-through; }.reason { width:100%; height:160rpx; background:#F3F8F9; padding:20rpx; border-radius:16rpx; font-size:27rpx; }.footnote { font-size:22rpx; color:#637B82; margin:24rpx 4rpx; }.bottom-actions { display:flex; gap:18rpx; }.bottom-actions button { flex:1; padding:22rpx 14rpx; font-size:26rpx; }.text-button { color:#51686F; padding:18rpx 0; font-size:25rpx; }.discard { margin:20rpx auto 0; color:#A9342B; }
