.law-citation { color: #3c618c; font-weight: 600; margin: 22rpx 0 8rpx; }
.unsigned-label { display: inline-block; margin-top: 12rpx; padding: 4rpx 14rpx; border-radius: 12rpx; color: #ad6d34; background: #fff0dc; font-weight: 600; }
.reading-title { font-size: 26rpx; font-weight: 700; margin: 28rpx 0 12rpx; }
.sheet button.reading-row { width: 100%; display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; font-size: 24rpx; text-align: left; color: #51686f; background: transparent; }
.reading-box { flex-shrink: 0; width: 34rpx; height: 34rpx; border: 2rpx solid #b9cdd0; border-radius: 9rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.reading-box.checked { background: #0e7c86; border-color: #0e7c86; }
.reading-box image { width: 26rpx; height: 26rpx; }
.success-note { padding: 20rpx 24rpx; font-size: 24rpx; line-height: 1.6; color: #2c7a59; background: #e7f5ed; border-radius: 24rpx; margin-top: 20rpx; }
.sheet-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.sheet .sheet-actions button { flex: 1; padding: 22rpx 12rpx; font-size: 28rpx; border-radius: 26rpx; font-weight: 600; }
.outline-button { color: #0a5a61; border: 2rpx solid #0e7c86; background: #fff; }
.primary-button { color: #fff; background: #0e7c86; }
.sheet button.full-button { width: 100%; padding: 22rpx 18rpx; font-size: 28rpx; border-radius: 26rpx; font-weight: 600; margin-top: 28rpx; }
.sheet button.lawyer-row { display: flex; align-items: center; gap: 22rpx; padding: 24rpx; border: 2rpx solid #e2ecee; border-radius: 28rpx; background: #fff; margin-bottom: 18rpx; text-align: left; }
.sheet button.lawyer-selected { border-color: #0e7c86; background: #fbfdfc; }
.lawyer-avatar { width: 84rpx; height: 84rpx; flex-shrink: 0; border-radius: 24rpx; background: #edf2f9; color: #3c618c; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 700; }
.warm-avatar { background: #fff0e5; color: #c9613c; }
.lawyer-copy { flex: 1; min-width: 0; }
.lawyer-name { display: flex; align-items: center; gap: 10rpx; font-size: 27rpx; font-weight: 700; color: #173b43; flex-wrap: wrap; }
.lawyer-tag { padding: 4rpx 14rpx; border-radius: 18rpx; font-size: 20rpx; font-weight: 600; }
.free { color: #2c7a59; background: #e7f5ed; }
.professional { color: #a9791f; background: #fff3da; }
.lawyer-description { font-size: 23rpx; line-height: 1.5; color: #51686f; margin-top: 8rpx; }
.selection-dot { width: 28rpx; height: 28rpx; box-sizing: border-box; border: 2rpx solid #b9cdd0; border-radius: 50%; flex-shrink: 0; }
.selection-dot.on { border: 8rpx solid #0e7c86; background: #fff; }
.lawyer-notice { color: #9a733d; font-size: 24rpx; line-height: 1.6; background: #fff4e7; border: 2rpx solid #f4e4ca; border-radius: 24rpx; padding: 22rpx 24rpx; margin-top: 8rpx; }
.knowledge-citation { color: #3c618c; background: #edf2f9; border-radius: 22rpx; font-size: 25rpx; font-weight: 600; line-height: 1.6; padding: 22rpx 24rpx; margin-bottom: 24rpx; }
.knowledge-summary { font-size: 28rpx; color: #4d6971; line-height: 1.85; }
.knowledge-note { margin-top: 24rpx; }

/* 法知入口：天平开场动画；动画只在本页，不进入对话页 */
.legal-intro { position: fixed; inset: 0; z-index: 300; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80rpx 56rpx 56rpx; overflow: hidden; color: #f6f2e8; background: radial-gradient(circle at 50% 30%, #294b60 0%, #172b3b 48%, #0b1722 100%); animation: intro-arrive .45s ease both; }
.legal-intro.closing { animation: none; opacity: 0; transition: opacity .22s ease; }
.intro-glow { position: absolute; top: 8%; left: 50%; width: 560rpx; height: 560rpx; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(circle, rgba(216,181,106,.18) 0%, rgba(32,111,118,.12) 38%, rgba(11,23,34,0) 70%); pointer-events: none; }
.intro-kicker { position: relative; z-index: 2; padding: 8rpx 22rpx; border: 2rpx solid rgba(216,181,106,.38); border-radius: 40rpx; color: #d8b56a; font-size: 20rpx; letter-spacing: 4rpx; }
.scales-stage { position: relative; z-index: 2; width: 420rpx; height: 330rpx; margin: 14rpx 0 0; flex: none; }
.halo { position: absolute; left: 50%; border-radius: 50%; border: 2rpx solid rgba(216,181,106,.18); transform: translateX(-50%); animation: halo-breathe 4.8s ease-in-out infinite; }
.halo-one { top: 16rpx; width: 330rpx; height: 330rpx; }
.halo-two { top: 62rpx; width: 236rpx; height: 236rpx; border-color: rgba(82,160,162,.22); animation-delay: -2.4s; }
.scale-beam { position: absolute; z-index: 3; top: 76rpx; left: 50%; width: 300rpx; height: 6rpx; margin-left: -150rpx; transform-origin: center; animation: beam-weigh 4.2s ease-in-out infinite; }
.beam-line { width: 100%; height: 6rpx; border-radius: 6rpx; background: linear-gradient(90deg, #b98a45, #f0d49a 50%, #b98a45); box-shadow: 0 0 18rpx rgba(216,181,106,.4); }
.beam-pivot { position: absolute; z-index: 4; top: -13rpx; left: 50%; width: 30rpx; height: 30rpx; margin-left: -15rpx; box-sizing: border-box; border: 4rpx solid #f0d49a; border-radius: 50%; background: #172b3b; box-shadow: 0 0 0 6rpx rgba(216,181,106,.12); }
.scale-side { position: absolute; z-index: 2; top: 78rpx; width: 120rpx; display: flex; flex-direction: column; align-items: center; }
.side-left { left: 0; animation: pan-left 4.2s ease-in-out infinite; }
.side-right { right: 0; animation: pan-right 4.2s ease-in-out infinite; }
.scale-rope { width: 3rpx; height: 66rpx; background: linear-gradient(180deg, rgba(240,212,154,.9), rgba(216,181,106,.35)); }
.scale-pan { box-sizing: border-box; width: 112rpx; height: 56rpx; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 6rpx; border: 3rpx solid rgba(216,181,106,.85); border-top-width: 6rpx; border-radius: 0 0 56rpx 56rpx; background: linear-gradient(180deg, rgba(216,181,106,.14), rgba(216,181,106,.02)); color: #e8cd94; font-size: 21rpx; line-height: 1; }
.scale-column { position: absolute; z-index: 1; top: 76rpx; left: 50%; width: 8rpx; height: 182rpx; margin-left: -4rpx; border-radius: 8rpx; background: linear-gradient(180deg, #d8b56a, #8d6b35 74%, rgba(141,107,53,.2)); }
.scale-foot { position: absolute; z-index: 2; top: 252rpx; left: 50%; width: 190rpx; height: 12rpx; margin-left: -95rpx; border-radius: 12rpx; background: linear-gradient(90deg, rgba(216,181,106,.2), #d8b56a 50%, rgba(216,181,106,.2)); box-shadow: 0 10rpx 24rpx -8rpx rgba(216,181,106,.5); }
.scale-spark { position: absolute; z-index: 4; width: 8rpx; height: 8rpx; border-radius: 50%; background: #f0d49a; box-shadow: 0 0 12rpx rgba(240,212,154,.8); animation: spark-twinkle 3.2s ease-in-out infinite; }
.spark-one { top: 58rpx; left: 54rpx; }
.spark-two { top: 192rpx; right: 38rpx; animation-delay: -1.1s; }
.spark-three { top: 36rpx; right: 92rpx; animation-delay: -2.2s; }
.intro-title { position: relative; z-index: 2; margin-top: 12rpx; font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; line-height: 1.4; text-align: center; animation: intro-rise .55s .12s ease both; }
.intro-copy { position: relative; z-index: 2; max-width: 560rpx; margin-top: 18rpx; color: rgba(238,242,238,.72); font-size: 25rpx; line-height: 1.8; text-align: center; animation: intro-rise .55s .2s ease both; }
.intro-tags { position: relative; z-index: 2; display: flex; gap: 12rpx; margin-top: 28rpx; animation: intro-rise .55s .28s ease both; }
.intro-tags text { padding: 8rpx 20rpx; border: 2rpx solid rgba(216,181,106,.24); border-radius: 40rpx; color: #d8b56a; font-size: 20rpx; line-height: 1.4; }
.legal-page button.intro-start { position: relative; z-index: 2; width: 320rpx; height: 86rpx; padding: 0; border: 0; margin-top: 42rpx; border-radius: 44rpx; display: flex; align-items: center; justify-content: center; color: #16283b; font-size: 28rpx; font-weight: 600; line-height: 1.4; background: linear-gradient(135deg, #f0d49a, #c69a53); box-shadow: 0 16rpx 40rpx -18rpx rgba(216,181,106,.75); animation: intro-rise .55s .36s ease both; }
.intro-note { position: relative; z-index: 2; margin-top: 22rpx; color: rgba(238,242,238,.45); font-size: 20rpx; line-height: 1.5; text-align: center; animation: intro-rise .55s .44s ease both; }
@keyframes intro-arrive { from { opacity: 0; } to { opacity: 1; } }
@keyframes intro-rise { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes beam-weigh { 0%,100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }
@keyframes pan-left { 0%,100% { transform: translateY(-10rpx); } 50% { transform: translateY(12rpx); } }
@keyframes pan-right { 0%,100% { transform: translateY(12rpx); } 50% { transform: translateY(-10rpx); } }
@keyframes halo-breathe { 0%,100% { opacity: .45; transform: translateX(-50%) scale(.94); } 50% { opacity: 1; transform: translateX(-50%) scale(1.04); } }
@keyframes spark-twinkle { 0%,100% { opacity: .2; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.2); } }

/* ===== 法知开场动效升级（2026-11-07）=====
   华丽但克制：只做视差、呼吸、微摆与扫光，不改变布局。 */
@keyframes intro-enter { from { opacity:0; transform:scale(.965) } to { opacity:1; transform:scale(1) } }
@keyframes glow-breathe {
  0%,100% { opacity:.55; transform:scale(1) }
  50% { opacity:.9; transform:scale(1.08) }
}
@keyframes halo-spin { from { transform:rotate(0) } to { transform:rotate(360deg) } }
@keyframes halo-spin-rev { from { transform:rotate(360deg) } to { transform:rotate(0) } }
@keyframes stage-rise { from { opacity:0; transform:translateY(28rpx) scale(.94) } to { opacity:1; transform:none } }
@keyframes beam-wobble {
  0%,100% { transform:rotate(-2.2deg) }
  50% { transform:rotate(2.2deg) }
}
@keyframes pan-sway { 0%,100% { transform:translateY(2rpx) } 50% { transform:translateY(-4rpx) } }
@keyframes spark-twinkle {
  0%,100% { opacity:.25; transform:scale(.8) }
  50% { opacity:1; transform:scale(1.25) }
}
@keyframes title-in {
  0% { opacity:0; transform:translateY(18rpx); letter-spacing:.28em }
  100% { opacity:1; transform:none; letter-spacing:.06em }
}
@keyframes sweep { 0% { transform:translateX(-140%) } 100% { transform:translateX(140%) } }
@keyframes rise-in { from { opacity:0; transform:translateY(14rpx) } to { opacity:1; transform:none } }

.legal-intro { animation: intro-enter .55s cubic-bezier(.22,.61,.36,1) both }
.intro-glow { animation: glow-breathe 5.2s ease-in-out infinite }
.scales-stage { animation: stage-rise .8s cubic-bezier(.22,.61,.36,1) both }
.halo-one { animation: halo-spin 22s linear infinite }
.halo-two { animation: halo-spin-rev 30s linear infinite }
.scale-beam { transform-origin:50% 50%; animation: beam-wobble 7s ease-in-out infinite }
.scale-side .scale-pan { animation: pan-sway 7s ease-in-out infinite }
.scale-side.side-right .scale-pan { animation-delay: .6s }
.scale-spark.spark-one { animation: spark-twinkle 3.4s ease-in-out infinite }
.scale-spark.spark-two { animation: spark-twinkle 4.1s ease-in-out .6s infinite }
.scale-spark.spark-three { animation: spark-twinkle 3.8s ease-in-out 1.2s infinite }

.intro-title { animation: title-in .9s cubic-bezier(.22,.61,.36,1) .12s both }
.intro-copy { animation: rise-in .8s cubic-bezier(.22,.61,.36,1) .3s both }
.intro-tags text { animation: rise-in .7s cubic-bezier(.22,.61,.36,1) both }
.intro-start { animation: rise-in .8s cubic-bezier(.22,.61,.36,1) .78s both }
.intro-note { animation: rise-in .8s cubic-bezier(.22,.61,.36,1) .92s both }

/* ===== 庄严感增强（2026-11-07）=====
   金色顶光 + 四角暗角 + 更慢的摆动，营造"审慎、郑重"的情绪。 */
.intro-rays{
  position:absolute; top:-10%; left:50%; width:900rpx; height:900rpx; transform:translateX(-50%);
  background:radial-gradient(circle at 50% 42%, rgba(216,181,106,.16) 0%, rgba(216,181,106,.06) 30%, rgba(11,23,34,0) 62%);
  animation:glow-breathe 8.5s ease-in-out infinite; pointer-events:none}
.intro-vignette{
  position:absolute; top:0; right:0; bottom:0; left:0; pointer-events:none;
  background:radial-gradient(circle at 50% 44%, rgba(11,23,34,0) 38%, rgba(5,12,19,.42) 78%, rgba(3,8,13,.72) 100%)}
.intro-kicker{border-color:rgba(216,181,106,.52); letter-spacing:6rpx}
.intro-title{letter-spacing:.04em; text-shadow:0 6rpx 28rpx rgba(0,0,0,.35)}
.intro-tags text{border:1rpx solid rgba(216,181,106,.34); background:rgba(216,181,106,.06)}
.intro-start{box-shadow:0 18rpx 44rpx -20rpx rgba(216,181,106,.75), inset 0 2rpx 0 rgba(255,255,255,.4)}
.scale-beam{animation-duration:9s}
.halo-one{animation-duration:40s}
.halo-two{animation-duration:60s}

/* ===== 神圣感加强（2026-11-07 · 保持 4.5s 节奏）=====
   光柱 + 同心环 + 金尘 + 分隔线；标题加大字距、降低装饰密度。 */
.intro-beam{
  position:absolute; top:-6%; left:50%; width:460rpx; height:66%; transform:translateX(-50%);
  background:linear-gradient(180deg, rgba(216,181,106,.20) 0%, rgba(216,181,106,.07) 38%, rgba(11,23,34,0) 76%);
  filter:blur(2rpx); animation:beam-breathe 9s ease-in-out infinite; pointer-events:none}
@keyframes beam-breathe{ 0%,100%{opacity:.55} 50%{opacity:.95} }

.intro-ring{
  position:absolute; top:6%; left:50%; border-radius:50%; transform:translateX(-50%);
  border:1rpx solid rgba(216,181,106,.16); pointer-events:none}
.ring-outer{width:760rpx; height:760rpx; border-color:rgba(216,181,106,.12); animation:ring-turn 70s linear infinite}
.ring-inner{width:520rpx; height:520rpx; border-color:rgba(216,181,106,.22); animation:ring-turn-rev 46s linear infinite}
@keyframes ring-turn{ from{transform:translateX(-50%) rotate(0)} to{transform:translateX(-50%) rotate(360deg)} }
@keyframes ring-turn-rev{ from{transform:translateX(-50%) rotate(360deg)} to{transform:translateX(-50%) rotate(0)} }

.dust{position:absolute; width:6rpx; height:6rpx; border-radius:50%; background:rgba(226,198,124,.85);
  box-shadow:0 0 12rpx rgba(226,198,124,.65); animation:dust-float 11s ease-in-out infinite; pointer-events:none}
.d1{left:22%; top:38%; animation-delay:-1s}
.d2{left:74%; top:31%; animation-delay:-3.4s}
.d3{left:34%; top:62%; animation-delay:-5.2s}
.d4{left:66%; top:58%; animation-delay:-2.1s}
.d5{left:47%; top:24%; animation-delay:-6.6s}
.d6{left:58%; top:70%; animation-delay:-8s}
@keyframes dust-float{
  0%,100%{opacity:.15; transform:translateY(0) scale(.8)}
  50%{opacity:.9; transform:translateY(-26rpx) scale(1.15)}
}

.intro-rule{width:96rpx; height:2rpx; margin:20rpx auto 6rpx;
  background:linear-gradient(90deg, rgba(216,181,106,0), rgba(216,181,106,.85), rgba(216,181,106,0));
  animation:rule-bloom 1.1s ease .5s both}
@keyframes rule-bloom{ from{opacity:0; transform:scaleX(.2)} to{opacity:1; transform:scaleX(1)} }

.intro-title{font-size:52rpx; letter-spacing:.10em; line-height:1.5; font-weight:600}
.intro-copy{color:rgba(246,242,232,.82); letter-spacing:.02em; line-height:1.9}
.intro-tags text{border:0; background:transparent; color:rgba(216,181,106,.78); letter-spacing:.14em; font-size:19rpx}
.intro-kicker{padding:6rpx 26rpx; letter-spacing:.30em; color:rgba(216,181,106,.9)}

/* ===== 天平精修：金线浮雕（2026-11-07）===== */
