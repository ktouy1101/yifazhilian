  width:120rpx; height:58rpx; border-width:3rpx; border-top-width:5rpx;
  border-color:rgba(240,212,154,.9); border-radius:0 0 60rpx 60rpx;
  background:linear-gradient(180deg, rgba(216,181,106,.20), rgba(216,181,106,.03) 60%, rgba(11,23,34,0));
  box-shadow:0 0 26rpx rgba(216,181,106,.28), 0 -2rpx 0 rgba(247,227,180,.25) inset}
.scale-foot{
  height:10rpx; width:210rpx; margin-left:-105rpx;
  background:linear-gradient(90deg, rgba(216,181,106,.08), #e0bf85 50%, rgba(216,181,106,.08));
  box-shadow:0 12rpx 30rpx -10rpx rgba(216,181,106,.65), 0 26rpx 40rpx -22rpx rgba(0,0,0,.6)}
.scale-foot::after{
  content:''; position:absolute; left:50%; top:16rpx; width:120rpx; height:2rpx; margin-left:-60rpx;
  background:linear-gradient(90deg, rgba(216,181,106,0), rgba(216,181,106,.55), rgba(216,181,106,0))}
.scales-stage{filter:drop-shadow(0 18rpx 40rpx rgba(0,0,0,.45))}

/* ===== 经典正义天平形制（2026-11-07）=====
   顶部宝珠 → 横梁（两端球帽）→ V 形双链 → 浅碟托盘 → 柱头 → 柱身 → 双层柱础 */
.scales-stage{width:460rpx; height:360rpx}
.scale-finial{
  position:absolute; z-index:5; top:40rpx; left:50%; width:18rpx; height:18rpx; margin-left:-9rpx;
  transform:rotate(45deg); border-radius:3rpx;
  background:linear-gradient(135deg,#f7e3b4,#c99a4e);
  box-shadow:0 0 20rpx rgba(247,227,180,.85), 0 0 40rpx rgba(216,181,106,.35)}
.scale-finial::after{
  content:''; position:absolute; left:50%; top:24rpx; width:2rpx; height:16rpx; margin-left:-1rpx;
  background:linear-gradient(180deg, rgba(247,227,180,.9), rgba(216,181,106,0))}

.scale-beam{top:78rpx; width:340rpx; margin-left:-170rpx}
.beam-cap{
  position:absolute; top:-7rpx; width:16rpx; height:16rpx; border-radius:50%;
  background:radial-gradient(circle at 38% 34%, #fdf0cd, #c99a4e 72%);
  box-shadow:0 0 16rpx rgba(240,212,154,.7)}
.cap-left{left:-9rpx} .cap-right{right:-9rpx}
.beam-pivot{
  width:30rpx; height:30rpx; top:-13rpx; margin-left:-15rpx; border-width:3rpx;
  border-color:#f7e3b4; background:radial-gradient(circle at 40% 36%, #7a6338, #16283a 76%)}

.scale-rope{
  width:2rpx; height:88rpx; transform-origin:top center;
  background:linear-gradient(180deg, rgba(247,227,180,.95), rgba(216,181,106,.22));
  box-shadow:0 0 10rpx rgba(240,212,154,.35)}
.rope-a{left:0; transform:rotate(16deg)} .rope-b{left:0; transform:rotate(-16deg)}
.side-right .rope-a{transform:rotate(-16deg)} .side-right .rope-b{transform:rotate(16deg)}

.scale-pan{
  position:relative; width:132rpx; height:52rpx; box-sizing:border-box;
  border:3rpx solid rgba(240,212,154,.85); border-top-width:4rpx;
  border-radius:6rpx 6rpx 66rpx 66rpx;
  background:linear-gradient(180deg, rgba(216,181,106,.26) 0%, rgba(216,181,106,.06) 55%, rgba(11,23,34,0) 100%);
  box-shadow:0 0 26rpx rgba(216,181,106,.32), inset 0 2rpx 0 rgba(255,255,255,.25)}
.pan-rim{
  position:absolute; left:-3rpx; right:-3rpx; top:-7rpx; height:14rpx; border-radius:50%;
  background:radial-gradient(ellipse at 50% 40%, rgba(247,227,180,.85), rgba(201,154,78,.55) 70%, rgba(201,154,78,0) 100%);
  opacity:.9}

.scale-capital{
  position:absolute; z-index:3; top:104rpx; left:50%; width:56rpx; height:10rpx; margin-left:-28rpx;
  border-radius:6rpx; background:linear-gradient(90deg, rgba(216,181,106,.15), #e6c489 50%, rgba(216,181,106,.15));
  box-shadow:0 0 18rpx rgba(240,212,154,.45)}
.scale-column{
  top:112rpx; height:172rpx; width:12rpx; margin-left:-6rpx; border-radius:0 0 6rpx 6rpx;
  background:linear-gradient(90deg, rgba(141,107,53,.45), #f0d49a 44%, #a97f42 76%, rgba(141,107,53,.4));
  box-shadow:0 0 20rpx rgba(216,181,106,.3)}
.scale-foot{
  top:282rpx; width:230rpx; margin-left:-115rpx; height:12rpx; border-radius:8rpx;
  background:linear-gradient(90deg, rgba(216,181,106,.05), #e0bf85 50%, rgba(216,181,106,.05));
  box-shadow:0 10rpx 26rpx -8rpx rgba(216,181,106,.6)}
.foot-tier{
  position:absolute; left:50%; top:18rpx; width:150rpx; height:8rpx; margin-left:-75rpx; border-radius:6rpx;
  background:linear-gradient(90deg, rgba(216,181,106,.04), rgba(216,181,106,.75) 50%, rgba(216,181,106,.04));
  box-shadow:0 8rpx 20rpx -10rpx rgba(216,181,106,.55)}

/* ===== 金色徽标：光效与动效（2026-11-07）===== */
.scales-stage{width:520rpx; height:400rpx; filter:drop-shadow(0 24rpx 48rpx rgba(0,0,0,.45))}
.scales-emblem{
  position:relative; z-index:3; width:100%; height:100%;
  filter:drop-shadow(0 0 22rpx rgba(247,227,180,.55)) drop-shadow(0 0 60rpx rgba(216,181,106,.30));
  animation:emblem-float 7.5s ease-in-out infinite}
@keyframes emblem-float{
  0%,100%{transform:translateY(0) scale(1)}
  50%{transform:translateY(-9rpx) scale(1.012)}
}
@keyframes emblem-glow{
  0%,100%{filter:drop-shadow(0 0 18rpx rgba(247,227,180,.45)) drop-shadow(0 0 52rpx rgba(216,181,106,.22))}
  50%{filter:drop-shadow(0 0 30rpx rgba(247,227,180,.75)) drop-shadow(0 0 84rpx rgba(216,181,106,.38))}
}
.scales-emblem{animation:emblem-float 7.5s ease-in-out infinite, emblem-glow 6s ease-in-out infinite}

/* 收尾微调（2026-11-07） */
.intro-title{font-size:50rpx; letter-spacing:.03em; line-height:1.45}
.scales-stage{width:560rpx; height:430rpx; margin:6rpx 0 4rpx}
.intro-kicker{margin-bottom:2rpx}
.intro-copy{max-width:520rpx; margin:10rpx auto 0}
.intro-tags{margin-top:16rpx}

/* 周边动效加强（2026-11-07） */
.halo-one{border-color:rgba(216,181,106,.34); box-shadow:0 0 34rpx rgba(216,181,106,.22); animation-duration:24s}
.halo-two{border-color:rgba(240,212,154,.48); box-shadow:0 0 26rpx rgba(240,212,154,.20); animation-duration:16s}
.pulse{
  position:absolute; z-index:1; left:50%; top:54%; width:280rpx; height:280rpx; margin:-140rpx 0 0 -140rpx;
  border-radius:50%; border:2rpx solid rgba(240,212,154,.55); animation:pulse-out 3.4s ease-out infinite}
.pulse.p2{animation-delay:1.7s}
@keyframes pulse-out{
  0%{opacity:.85; transform:scale(.55)}
  100%{opacity:0; transform:scale(1.55)}
}
.dust{width:8rpx; height:8rpx; box-shadow:0 0 16rpx rgba(247,227,180,.9)}
@keyframes dust-float{
  0%,100%{opacity:.12; transform:translateY(6rpx) scale(.7)}
  50%{opacity:1; transform:translateY(-34rpx) scale(1.25)}
}

/* 麦穗放大 + 天平本体分层（2026-11-07） */
.scales-stage{width:600rpx; height:470rpx}
.scales-wreath{
  position:absolute; left:50%; top:50%; width:600rpx; height:600rpx; margin:-300rpx 0 0 -300rpx;
  z-index:2; animation:wreath-turn 46s linear infinite, wreath-glow 5.4s ease-in-out infinite}
.scales-core{
  position:absolute; left:50%; top:50%; width:340rpx; height:340rpx; margin:-170rpx 0 0 -170rpx;
  z-index:3; animation:emblem-float 7.5s ease-in-out infinite, emblem-glow 6s ease-in-out infinite}
@keyframes wreath-turn{ from{transform:rotate(0)} to{transform:rotate(360deg)} }
@keyframes wreath-glow{
  0%,100%{filter:drop-shadow(0 0 20rpx rgba(216,181,106,.35))}
  50%{filter:drop-shadow(0 0 44rpx rgba(240,212,154,.70))}
}

/* 麦穗放大到出画：只留弧线在画面里（2026-11-07） */
.scales-stage{width:620rpx; height:470rpx; overflow:hidden; border-radius:24rpx}
.scales-wreath{
  width:1080rpx; height:1080rpx; margin:-540rpx 0 0 -540rpx;
  opacity:.95; animation:wreath-turn 60s linear infinite, wreath-glow 5.4s ease-in-out infinite}
.scales-core{width:330rpx; height:330rpx; margin:-165rpx 0 0 -165rpx}

/* 去掉中间矩形裁切，麦穗改为延伸到整屏（2026-11-07） */
.scales-stage{width:620rpx; height:520rpx; overflow:visible; border-radius:0}
.scales-wreath{width:1320rpx; height:1320rpx; margin:-660rpx 0 0 -660rpx; opacity:.9}
.scales-core{width:430rpx; height:430rpx; margin:-215rpx 0 0 -215rpx}

/* 麦穗不与文字打架（2026-11-07） */
.scales-stage{height:440rpx}
.scales-wreath{width:1080rpx; height:1080rpx; margin:-540rpx 0 0 -540rpx; top:46%; opacity:.42; z-index:1}
.scales-core{z-index:2}
.intro-title,.intro-copy,.intro-tags,.intro-start,.intro-note,.intro-kicker{position:relative; z-index:4}

/* 麦穗改为马蹄形 + 天平上下浮动放大（2026-11-07） */
.scales-wreath{
  width:1180rpx; height:1180rpx; margin:-590rpx 0 0 -590rpx; top:52%;
  opacity:.62; z-index:1;
  animation:wreath-breathe 6.5s ease-in-out infinite, wreath-glow 5.4s ease-in-out infinite}
@keyframes wreath-breathe{
  0%,100%{transform:translateY(6rpx) scale(1)}
  50%{transform:translateY(-8rpx) scale(1.02)}
}
.scales-core{
  width:520rpx; height:520rpx; margin:-260rpx 0 0 -260rpx; z-index:2;
  animation:scales-float 4.2s ease-in-out infinite, emblem-glow 6s ease-in-out infinite}
@keyframes scales-float{
  0%,100%{transform:translateY(10rpx)}
  50%{transform:translateY(-18rpx)}
}
/* 麦穗上移，只托住天平，不压文字 */
.scales-wreath{width:1000rpx; height:1000rpx; margin:-500rpx 0 0 -500rpx; top:38%; opacity:.5}
.scales-core{width:500rpx; height:500rpx; margin:-250rpx 0 0 -250rpx}

/* 称量动效：绕轴心微倾（左盘下沉 / 右盘上升），不做整体上下浮动 */
.scales-core{
  transform-origin:50% 21%;
  animation:beam-tilt 5.2s ease-in-out infinite, emblem-glow 6s ease-in-out infinite}
@keyframes beam-tilt{
  0%   {transform:rotate(-2.4deg)}
  50%  {transform:rotate(2.4deg)}
  100% {transform:rotate(-2.4deg)}
}

/* 托盘与主干分离：主干静止，横梁+链条+托盘绕轴心摆动（2026-11-07） */
.scales-core{animation:none}
.scales-body,.scales-top{
  position:absolute; left:50%; top:50%; width:500rpx; height:500rpx; margin:-250rpx 0 0 -250rpx; z-index:2}
.scales-body{animation:emblem-glow 6s ease-in-out infinite}
.scales-top{
  transform-origin:50% 31%;
  animation:pan-swing 5.2s ease-in-out infinite, emblem-glow 6s ease-in-out infinite}
@keyframes pan-swing{
  0%   {transform:rotate(-2.6deg)}
  50%  {transform:rotate(2.6deg)}
  100% {transform:rotate(-2.6deg)}
}
/* 修正：托盘纳入摆动层，幅度加大便于观察 */
.scales-top{transform-origin:50% 31%; animation:pan-swing 5.2s ease-in-out infinite, emblem-glow 6s ease-in-out infinite}
@keyframes pan-swing{
  0%   {transform:rotate(-4deg)}
  50%  {transform:rotate(4deg)}
  100% {transform:rotate(-4deg)}
}
