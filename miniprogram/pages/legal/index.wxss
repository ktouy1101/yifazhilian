.tiny { font-size: 22rpx; line-height: 1.5; color: #8aa0a6; }
.legalgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-bottom: 24rpx; }
.legal-page button.legal-entry { width: 100%; color: #fff; border-radius: 32rpx; padding: 28rpx 26rpx; min-height: 192rpx; text-align: left; display: flex; flex-direction: column; align-items: flex-start; }
.entry-ai { background: linear-gradient(135deg, #15939c, #0a5a61); }
