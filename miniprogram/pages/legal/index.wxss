.entry-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; background: rgba(255,255,255,.2); border-radius: 20rpx; margin-bottom: 16rpx; }
.entry-icon image { width: 38rpx; height: 38rpx; }
.entry-title { font-size: 28rpx; font-weight: 700; line-height: 1.5; }
.entry-subtitle { font-size: 21rpx; opacity: .9; line-height: 1.5; margin-top: 2rpx; }
.knowledge-map { position: relative; margin-top: 16rpx; line-height: 0; }
.graph-image { width: 100%; display: block; }
.legal-page button.graph-hotspot { position: absolute; width: 16%; height: 26%; padding: 0; transform: translate(-50%, -50%); border: 0; border-radius: 50%; background: transparent; }
.graph-hint { text-align: center; margin-top: 4rpx; }
.process-card .section-title { margin-bottom: 20rpx; }
.process-flow { display: flex; align-items: center; padding: 8rpx 0; }
.legal-page button.process-step { flex: 1; min-width: 0; padding: 0; background: transparent; }
.process-number { width: 68rpx; height: 68rpx; border-radius: 50%; margin: 0 auto 10rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 700; color: #3c618c; background: #edf2f9; }
.process-label { font-size: 21rpx; color: #51686f; line-height: 1.4; }
.process-arrow { color: #8aa0a6; font-size: 30rpx; width: 14rpx; text-align: center; margin: 0 2rpx 32rpx; }
.sheet-mask { position: fixed; inset: 0; z-index: 999; background: rgba(12,30,36,.42); display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #fff; border-radius: 52rpx 52rpx 0 0; overflow: hidden; }
.sheet-header { display: flex; justify-content: space-between; align-items: center; padding: 36rpx 36rpx 8rpx; gap: 12rpx; }
.sheet-title { font-size: 34rpx; font-weight: 700; }
.sheet button.sheet-close { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 60rpx; height: 60rpx; padding: 0; border-radius: 50%; background: #f0f5f5; }
.sheet-close image { width: 32rpx; height: 32rpx; }
.sheet-scroll { max-height: 72vh; }
.sheet-scroll.long-sheet { height: 72vh; }
.sheet-content { padding: 0 36rpx calc(40rpx + env(safe-area-inset-bottom)); }
.sheet-subtitle { font-size: 24rpx; color: #8aa0a6; line-height: 1.65; margin-bottom: 28rpx; }
.pickrow { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; }
.sheet button.pick-button { padding: 16rpx 26rpx; font-size: 25rpx; border-radius: 40rpx; border: 2rpx solid #dbe6e8; background: #fff; color: #51686f; }
.sheet button.pick-button.selected { background: #e5f3f2; color: #0a5a61; border-color: #0e7c86; font-weight: 600; }
.consent-doc { background: #f5f8f7; padding: 28rpx; border-radius: 28rpx; color: #51686f; font-size: 25rpx; line-height: 1.75; }
.doc-heading { font-size: 26rpx; font-weight: 700; color: #173b43; margin: 22rpx 0 8rpx; }
