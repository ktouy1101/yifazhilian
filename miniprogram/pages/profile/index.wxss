.profile-page { padding-top: 28rpx; }
.patient-card { position: relative; overflow: hidden; padding: 32rpx; border-radius: 44rpx; color: #fff; background: linear-gradient(135deg, #35577e, #274060); margin-bottom: 24rpx; }
.patient-card::after { content: ''; position: absolute; top: -68rpx; right: -68rpx; width: 260rpx; height: 260rpx; border-radius: 50%; background: rgba(255,255,255,.07); pointer-events: none; }
.patient-main { display: flex; align-items: center; gap: 24rpx; position: relative; z-index: 1; }
.patient-avatar { display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; border-radius: 28rpx; background: rgba(255,255,255,.16); flex: none; }
.patient-avatar image { width: 52rpx; height: 52rpx; }
.patient-info { flex: 1; min-width: 0; }
.patient-name { font-size: 34rpx; font-weight: 700; line-height: 1.4; }
.patient-detail { font-size: 23rpx; opacity: .9; margin-top: 4rpx; }
.patient-demo { align-self: flex-start; font-size: 19rpx; border: 1rpx solid rgba(255,255,255,.28); border-radius: 16rpx; padding: 4rpx 12rpx; white-space: nowrap; }
.patient-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.patient-tags text { font-size: 21rpx; padding: 6rpx 18rpx; background: rgba(255,255,255,.14); border-radius: 24rpx; }
button.profile-entry { display: flex; align-items: center; gap: 26rpx; width: 100%; text-align: left; min-height: 152rpx; margin: 0 0 24rpx; padding: 30rpx; line-height: 1.5; box-sizing: border-box; }
.profile-entry::after, .sheet-panel button::after { border: 0; }
.entry-pressed { opacity: .78; }
.entry-icon { width: 92rpx; height: 92rpx; border-radius: 26rpx; flex: none; display: flex; align-items: center; justify-content: center; }
.entry-icon image { width: 44rpx; height: 44rpx; }
.medical { background: #e2f2f3; }
.legal { background: #e8edf5; }
.entry-copy { flex: 1; min-width: 0; }
.entry-title { font-size: 30rpx; font-weight: 700; color: #132930; }
.entry-detail { margin-top: 4rpx; font-size: 22rpx; color: #8aa0a6; }
.entry-arrow { width: 36rpx; height: 36rpx; flex: none; }
.devices-card { padding: 30rpx; margin-bottom: 24rpx; }
.device-heading { margin-bottom: 12rpx; display: flex; align-items: center; }
.section-tag { margin-left: auto; color: #8aa0a6; font-size: 20rpx; font-weight: 400; }
.device-row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #e2ecee; }
.device-row:last-child { border-bottom: none; padding-bottom: 6rpx; }
.device-icon { width: 68rpx; height: 68rpx; border-radius: 22rpx; flex: none; display: flex; align-items: center; justify-content: center; }
.device-icon image { width: 34rpx; height: 34rpx; }
.device-copy { flex: 1; min-width: 0; }
.device-name { font-size: 27rpx; font-weight: 500; }
.device-detail { font-size: 21rpx; margin-top: 4rpx; color: #8aa0a6; }
.device-state { font-size: 21rpx; color: #3d8c70; white-space: nowrap; display: flex; align-items: center; gap: 8rpx; }
.state-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #3fa67a; }
.muted-state { color: #8aa0a6; }
.profile-footnote { display: flex; align-items: flex-start; justify-content: center; gap: 8rpx; padding: 22rpx 4rpx 8rpx; font-size: 21rpx; line-height: 1.6; color: #8aa0a6; }
.profile-footnote image { width: 24rpx; height: 24rpx; flex: none; margin-top: 4rpx; }
.sheet-layer { position: fixed; inset: 0; z-index: 100; }
.sheet-mask { position: absolute; inset: 0; background: rgba(12,30,36,.42); }
.sheet-panel { position: absolute; left: 0; right: 0; bottom: 0; border-radius: 52rpx 52rpx 0 0; background: #fff; overflow: hidden; padding-bottom: env(safe-area-inset-bottom); color: #132930; }
.sheet-handle { width: 64rpx; height: 8rpx; background: #dce7e9; border-radius: 8rpx; margin: 16rpx auto 0; }
.sheet-head { padding: 22rpx 36rpx 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.sheet-title { font-size: 34rpx; font-weight: 700; }
.sheet-subtitle { font-size: 24rpx; color: #8aa0a6; margin-top: 6rpx; }
button.sheet-close { width: 60rpx; height: 60rpx; min-height: 0; margin: 0; padding: 0; border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; background: #e8f1f2; }
.sheet-close image { width: 30rpx; height: 30rpx; }
.sheet-scroll { height: 65vh; }
.sheet-body { padding: 0 36rpx 40rpx; box-sizing: border-box; }
button.capture-button { display: flex; align-items: center; justify-content: center; gap: 14rpx; width: 100%; min-height: 88rpx; margin: 0 0 28rpx; padding: 22rpx 24rpx; border-radius: 44rpx; background: linear-gradient(135deg,#0e7c86,#0a5a61); color: #fff; font-size: 27rpx; font-weight: 600; line-height: 1.4; }
.capture-button image { width: 36rpx; height: 36rpx; }
.capture-button text { font-size: 20rpx; opacity: .8; font-weight: 400; }
.record-item { border: 1rpx solid #e2ecee; border-radius: 32rpx; padding: 24rpx; margin-bottom: 18rpx; }
.record-top { display: flex; gap: 20rpx; align-items: center; }
.record-icon { width: 76rpx; height: 76rpx; border-radius: 22rpx; background: #e2f2f3; flex: none; display: flex; align-items: center; justify-content: center; }
.record-icon image { width: 36rpx; height: 36rpx; }
.record-copy { flex: 1; min-width: 0; }
.record-title { font-size: 26rpx; font-weight: 700; }
.record-date { font-size: 22rpx; color: #8aa0a6; margin-top: 6rpx; }
.record-status { border-radius: 22rpx; padding: 6rpx 14rpx; font-size: 20rpx; white-space: nowrap; background: #e4f4ee; color: #2c7a59; }
.record-status.pending { background: #fceee6; color: #c9613c; }
.record-note { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx dashed #e2ecee; font-size: 24rpx; color: #51686f; line-height: 1.7; }
.sheet-note { font-size: 22rpx; line-height: 1.65; color: #8aa0a6; margin-top: 18rpx; }
.connection-card { background: #f3f8f9; border-radius: 28rpx; padding: 24rpx; margin-bottom: 34rpx; }
.connection-top { display: flex; align-items: center; gap: 18rpx; }
.connection-copy { flex: 1; }
.connection-detail { font-size: 22rpx; color: #8aa0a6; margin-top: 4rpx; }
.connection-badge { font-size: 20rpx; color: #0a5a61; background: #e2f2f3; border-radius: 20rpx; padding: 6rpx 16rpx; }
button.connect-button, button.disconnect-button { width: 100%; min-height: 76rpx; padding: 18rpx 20rpx; margin: 22rpx 0 0; border-radius: 38rpx; font-size: 25rpx; font-weight: 600; line-height: 1.4; }
button.connect-button { background: #0e7c86; color: #fff; }
button.disconnect-button { color: #51686f; background: #fff; border: 1rpx solid #e2ecee; font-weight: 400; }
.setting-group { margin-bottom: 36rpx; }
.group-title { font-size: 26rpx; font-weight: 700; color: #51686f; display: flex; align-items: center; }
.group-caption { font-size: 21rpx; font-weight: 400; margin-left: auto; color: #8aa0a6; }
.level-row { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx dashed #e2ecee; }
.level-badge { font-size: 20rpx; font-weight: 700; padding: 4rpx 14rpx; border-radius: 18rpx; flex: none; }
.level-l3 { color: #c23f34; background: #fce9e7; }
.level-l2 { color: #a9791f; background: #fbf2de; }
.level-l1 { color: #2c7a59; background: #e4f4ee; }
.level-title { font-size: 25rpx; font-weight: 600; }
.level-detail { font-size: 21rpx; color: #8aa0a6; margin-top: 4rpx; }
.level-side { margin-left: auto; font-size: 21rpx; color: #8aa0a6; white-space: nowrap; }
.level-note { padding: 16rpx 20rpx; border-radius: 20rpx; background: #f3f8f9; }
.consent-item { padding: 24rpx 0; border-bottom: 1rpx solid #e2ecee; }
.consent-top { display: flex; justify-content: space-between; align-items: center; }
.consent-title { font-size: 27rpx; font-weight: 600; }
.consent-status { font-size: 21rpx; color: #8aa0a6; }
.consent-status.active { color: #2c7a59; }
.consent-detail { font-size: 22rpx; color: #8aa0a6; margin-top: 6rpx; }
.consent-expiry { font-size: 21rpx; color: #0E7C86; margin-top: 6rpx; }
.consent-actions { display: flex; gap: 14rpx; margin-top: 18rpx; }
.consent-actions button { min-height: 64rpx; padding: 14rpx 22rpx; font-size: 23rpx; line-height: 1.4; margin: 0; border-radius: 32rpx; }
.consent-grant { color: #0a5a61; background: #e2f2f3; }
.consent-revoke { color: #8aa0a6; background: #f3f8f9; }
.consent-actions button[disabled] { color: #a8b7bb; background: #f3f6f6; }
.preference-row { padding: 24rpx 0; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; font-size: 27rpx; border-bottom: 1rpx solid #e2ecee; }
.preference-row switch { transform: scale(.85); transform-origin: right center; }
.preference-value { font-size: 23rpx; color: #8aa0a6; }
.font-options { display: flex; gap: 12rpx; }
.font-options button { width: 76rpx; min-height: 64rpx; margin: 0; padding: 12rpx; font-size: 25rpx; line-height: 1.5; border-radius: 32rpx; background: #fff; color: #51686f; border: 1rpx solid #e2ecee; }
.font-options button.selected { border-color: #0e7c86; background: #e2f2f3; color: #0a5a61; font-weight: 600; }
.text-large .entry-title, .text-large .device-name, .text-large .record-title, .text-large .consent-title, .text-large .preference-row { font-size: 32rpx; }
.text-large .entry-detail, .text-large .record-date, .text-large .consent-detail, .text-large .level-detail { font-size: 25rpx; }
.text-small .entry-title, .text-small .device-name { font-size: 26rpx; }
.identity-item { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #e2ecee; }
.identity-copy { flex: 1; }
.identity-name { font-size: 26rpx; font-weight: 600; }
.identity-detail { font-size: 21rpx; color: #8aa0a6; margin-top: 4rpx; }
.identity-current { font-size: 22rpx; color: #2c7a59; background: #e6f4ec; padding: 6rpx 18rpx; border-radius: 24rpx; }
.identity-switch { font-size: 22rpx; color: #0a5a61; background: #e2f2f3; padding: 6rpx 18rpx; border-radius: 24rpx; }

.field-label{font-size:24rpx;color:#51686F;margin:24rpx 0 8rpx}
.field-input{background:#F2F7F8;border-radius:16rpx;padding:18rpx 20rpx;font-size:28rpx}
.gender-row{display:flex;gap:16rpx}
.gender-pick{flex:1;background:#F2F7F8;color:#51686F;font-size:26rpx;border-radius:16rpx;line-height:2.2}
.gender-pick.selected{background:#0E7C86;color:#fff}
.empty-hint{padding:40rpx 0;text-align:center;color:#8AA0A6;font-size:24rpx}
.primary-button.full-button{margin-top:40rpx;width:100%}
.full-width{width:100%;margin-top:20rpx}
