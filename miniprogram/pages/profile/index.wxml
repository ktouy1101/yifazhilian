<app-header />
<view class="page profile-page {{fontSize === '大' ? 'text-large' : ''}} {{fontSize === '小' ? 'text-small' : ''}}">
  <view class="patient-card" bindtap="openProfile" hover-class="entry-pressed">
    <view class="patient-main">
      <view class="patient-avatar"><image src="/assets/icons/user-white.png" mode="aspectFit" /></view>
      <view class="patient-info">
        <view class="patient-name">{{me && me.profile && me.profile.nickname ? me.profile.nickname : (me ? '微信用户' : '未登录')}}</view>
        <view class="patient-detail">
          {{me && me.profile && me.profile.age ? me.profile.age + '岁' : ''}}
          {{me && me.profile && me.profile.gender && me.profile.gender !== '未填' ? ' · ' + me.profile.gender : ''}}
          {{me && me.profile && me.profile.bed_location ? ' · ' + me.profile.bed_location : ''}}
        </view>
      </view>
      <view wx:if="{{me && me.profile && me.profile.allergies}}" class="patient-demo">过敏：{{me.profile.allergies}}</view>
    </view>
    <view class="patient-tags"><text>{{elderMode ? '适老模式已开启' : '标准显示模式'}}</text><text bindtap="openProfile">点击编辑资料 ›</text></view>
  </view>

  <button class="card profile-entry" bindtap="openHealth" hover-class="entry-pressed">
    <view class="entry-icon medical"><image src="/assets/icons/pulse-teal.png" mode="aspectFit" /></view>
    <view class="entry-copy"><view class="entry-title">健康与病历</view><view class="entry-detail">健康记录 · 用药计划 · 检验单与病历笔记</view></view>
    <image class="entry-arrow" src="/assets/icons/chevron-muted.png" mode="aspectFit" />
  </button>

  <button class="card profile-entry" bindtap="openSettings" hover-class="entry-pressed">
    <view class="entry-icon legal"><image src="/assets/icons/settings-law.png" mode="aspectFit" /></view>
    <view class="entry-copy"><view class="entry-title">设置</view><view class="entry-detail">隐私授权 · 账号</view></view>
    <image class="entry-arrow" src="/assets/icons/chevron-muted.png" mode="aspectFit" />
  </button>

  <button wx:if="{{canWorkbench}}" class="card profile-entry" bindtap="openNavigationWorkbench" hover-class="entry-pressed">
    <view class="entry-icon medical"><image src="/assets/icons/pin-teal.png" mode="aspectFit" /></view>
    <view class="entry-copy"><view class="entry-title">导航采集与路线管理</view><view class="entry-detail">领取、拍照、审核与发布</view></view>
    <image class="entry-arrow" src="/assets/icons/chevron-muted.png" mode="aspectFit" />
  </button>
  <emergency-button />
</view>

<view wx:if="{{sheet}}" class="sheet-layer {{fontSize === '大' ? 'text-large' : ''}}">
  <view class="sheet-mask" bindtap="closeSheet" catchtouchmove="noop"></view>
  <view class="sheet-panel">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <view>
        <view class="sheet-title">{{sheet === 'profile' ? '个人资料' : '设置'}}</view>
        <view class="sheet-subtitle">{{sheet === 'settings' ? '每一份授权，都由您决定' : ''}}</view>
      </view>
      <button class="sheet-close" bindtap="closeSheet" aria-label="关闭弹层"><image src="/assets/icons/close-muted.png" mode="aspectFit" /></button>
    </view>
    <scroll-view scroll-y class="sheet-scroll">

      <view wx:if="{{sheet === 'profile'}}" class="sheet-body">
        <view class="field-label">昵称</view>
        <input class="field-input" value="{{profileForm.nickname}}" data-field="nickname" bindinput="onProfileInput" placeholder="怎么称呼您" />
        <view class="field-label">年龄</view>
        <input class="field-input" type="number" value="{{profileForm.age}}" data-field="age" bindinput="onProfileInput" placeholder="如 30" />
        <view class="field-label">性别</view>
        <view class="gender-row">
          <button wx:for="{{['男','女','未填']}}" wx:key="*this" class="gender-pick {{profileForm.gender === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="onGenderPick">{{item}}</button>
        </view>
        <view class="field-label">床位 / 就诊位置</view>
        <input class="field-input" value="{{profileForm.bed_location}}" data-field="bed_location" bindinput="onProfileInput" placeholder="如 心内科 3 床" />
        <view class="field-label">过敏史</view>
        <input class="field-input" value="{{profileForm.allergies}}" data-field="allergies" bindinput="onProfileInput" placeholder="如 青霉素，无则留空" />
        <view class="field-label">病历上留的医生电话（可选）</view>
        <input class="field-input" maxlength="20" value="{{profileForm.doctor_phone}}" data-field="doctor_phone" bindinput="onProfileInput" placeholder="填了会显示在聊天页，可点击拨打" />
        <view class="field-label">紧急联系人</view>
        <input class="field-input" value="{{profileForm.emergency_name}}" data-field="emergency_name" bindinput="onProfileInput" placeholder="如 女儿/儿子" />
        <view class="field-label">紧急联系人电话</view>
        <input class="field-input" type="number" value="{{profileForm.emergency_phone}}" data-field="emergency_phone" bindinput="onProfileInput" placeholder="急救时自动拨打" />
        <button class="primary-button full-button" bindtap="saveProfile">保存</button>
      </view>

      <view wx:else class="sheet-body settings-body">
        <view class="connection-card">
          <view class="connection-top">
            <view class="connection-copy">
              <view class="group-title">{{previewMode ? '未登录' : '已登录'}}</view>
              <view class="connection-detail">{{previewMode ? '点击下方按钮，手机号登录' : '手机号登录'}}</view>
            </view>
            <text class="connection-badge">{{previewMode ? '未连接' : (serviceConnected ? '已连接' : '未确认')}}</text>
          </view>
          <button wx:if="{{previewMode}}" class="connect-button" bindtap="connectService" loading="{{connecting}}" disabled="{{connecting}}">手机号登录</button>
          <button wx:else class="disconnect-button" bindtap="logout" disabled="{{authorizationBusy}}">退出登录</button>
        </view>

        <view class="setting-group">
          <view class="group-title">隐私与授权</view>
          <view class="setting-group consent-group">
            <view class="consent-item" wx:for="{{scopes}}" wx:key="key">
              <view class="consent-top"><view class="consent-title">{{item.label}}</view><text class="consent-status {{item.active ? 'active' : ''}}">{{item.statusLabel}}</text></view>
              <view class="consent-detail">{{item.detail}}</view>
              <view wx:if="{{item.expiryLabel}}" class="consent-expiry">{{item.expiryLabel}}</view>
              <view class="consent-actions">
                <button class="consent-grant" data-scope="{{item.key}}" bindtap="grant" disabled="{{previewMode || authorizationBusy}}">{{item.active ? '查看并续期' : '查看告知并授权'}}</button>
                <button class="consent-revoke" data-scope="{{item.key}}" bindtap="revoke" disabled="{{previewMode || authorizationBusy}}">撤回</button>
              </view>
            </view>
            <view class="sheet-note">{{status}}</view>
          </view>
        </view>

        <view class="setting-group common-group">
          <view class="group-title">显示设置</view>
          <view class="preference-row"><text>适老模式</text><switch color="#0E7C86" checked="{{elderMode}}" bindchange="setElderMode" /></view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
