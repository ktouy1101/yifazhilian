/* 底部导航：与患者端 tabBar 同一套视觉（白底、青灰字、选中青色） */
.shell-nav{position:fixed;left:0;right:0;bottom:0;display:flex;align-items:stretch;background:#FFFFFF;border-top:1rpx solid #E4EDEE;padding-bottom:env(safe-area-inset-bottom);z-index:60;box-shadow:0 -4rpx 20rpx rgba(16,66,74,.04)}
.nav-item{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4rpx;padding:14rpx 0 12rpx;color:#8AA0A6}
.nav-item.on{color:#0E7C86}
.nav-icon{width:40rpx;height:40rpx;display:block}
.nav-label{font-size:20rpx;line-height:1.2}
.nav-item.on .nav-label{font-weight:600}
.nav-badge{position:absolute;top:6rpx;right:38rpx;min-width:28rpx;height:28rpx;line-height:28rpx;padding:0 8rpx;border-radius:14rpx;background:#D9634A;color:#fff;font-size:18rpx;text-align:center}
.nav-pressed{background:#F1F7F7}

/* 玻璃底栏（2026-11-07） */
.shell-nav{
  background:rgba(255,255,255,.72);
  -webkit-backdrop-filter:blur(30rpx) saturate(180%);
  backdrop-filter:blur(30rpx) saturate(180%);
  border-top:1rpx solid rgba(255,255,255,.85);
  box-shadow:0 -8rpx 30rpx rgba(16,66,74,.08)}
