<view class="shell-nav">
  <view wx:for="{{items}}" wx:key="key" class="nav-item {{active === item.key ? 'on' : ''}}"
        data-key="{{item.key}}" bindtap="pick" hover-class="nav-pressed">
    <image class="nav-icon" src="{{active === item.key ? (item.activeIcon || item.icon) : item.icon}}" mode="aspectFit" />
    <text class="nav-label">{{item.label}}</text>
    <text wx:if="{{item.badge}}" class="nav-badge">{{item.badge}}</text>
  </view>
</view>
