.header{background:linear-gradient(180deg,#E2F2F3,#F3F8F9);box-sizing:border-box}.bar{display:flex;align-items:center;gap:16rpx;padding-left:32rpx;box-sizing:border-box}.logo{width:60rpx;height:60rpx;border-radius:18rpx;background:linear-gradient(135deg,#0E7C86,#0A5A61);display:flex;align-items:center;justify-content:center;flex-shrink:0}.logo-image{width:36rpx;height:36rpx}.brand{min-width:0;display:flex;flex-direction:column}.title{font-size:32rpx;font-weight:700;color:#132930;line-height:1.35}.subtitle{font-size:20rpx;color:#51686F}
.header-fixed{position:fixed;top:0;left:0;right:0;z-index:100}
.bar-back{padding-left:16rpx;gap:16rpx}
.bar button.back-button{display:flex;align-items:center;justify-content:center;gap:4rpx;flex-shrink:0;min-width:112rpx;height:44px;min-height:44px;width:auto;margin:0;padding:0 12rpx 0 0;border:0;border-radius:12rpx;background:transparent;color:#0A5A61;font-size:27rpx;line-height:1.4;font-weight:500}
.back-button::after{border:0}
.back-icon{width:32rpx;height:32rpx;flex-shrink:0}
.bar button.back-pressed{background:#D8ECEE}
.bar-back .title{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:30rpx}

/* 未登录时右侧统一的登录入口 */
.bar button.login-entry{margin:0 0 0 auto;flex-shrink:0;min-width:96rpx;height:56rpx;line-height:56rpx;padding:0 24rpx;border:2rpx solid #B7D7D6;border-radius:28rpx;background:#FFFFFF;color:#0A5A61;font-size:24rpx;font-weight:500}
.bar button.login-entry::after{border:0}
.bar button.login-pressed{background:#D8ECEE}

/* 玻璃顶栏（2026-11-07） */
.header{
  background:rgba(255,255,255,.66);
  -webkit-backdrop-filter:blur(28rpx) saturate(180%);
  backdrop-filter:blur(28rpx) saturate(180%);
  border-bottom:1rpx solid rgba(255,255,255,.7);
  box-shadow:0 10rpx 30rpx -26rpx rgba(16,66,74,.5)}

/* 品牌标识：企鹅徽标（2026-11-07） */
.logo.logo-brand{background:transparent;box-shadow:0 10rpx 24rpx -14rpx rgba(14,124,134,.6)}
.logo-brand-image{width:60rpx;height:60rpx;border-radius:18rpx}
