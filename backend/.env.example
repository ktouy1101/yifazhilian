# Copy to backend/.env only for local configuration; never commit a real key.
# No configuration, or provider=mock, runs fully offline without paid API calls.
YIFAZHILIAN_AI_PROVIDER=mock
YIFAZHILIAN_AI_BASE_URL=https://api.deepseek.com
YIFAZHILIAN_AI_MODEL=deepseek-flash
YIFAZHILIAN_AI_DISPLAY_NAME=DeepSeek
YIFAZHILIAN_AI_API_KEY=

# Reported by /health. demo (default) or production; anything else is treated as demo.
YIFAZHILIAN_RUNTIME_MODE=demo
# Fixed code 123456 + echo for local demos. Turn off only after a real SMS channel exists.
YIFAZHILIAN_DEMO_AUTH=1
# 1 = when the legal MCP is down, answer from the local demo corpus and label it.
YIFAZHILIAN_LEGAL_MCP_FALLBACK=0
# 审核员（管理员）：逗号分隔的手机号，登录后自动获得 reviewer 能力。
# 也可以直接写进 backend/admins.txt（推荐，可提交、需评审）；两者取并集。
# 都留空则没有任何账号是管理员；审核员不能自助注册。
YIFAZHILIAN_ADMIN_PHONE=

# Optional read-only legal MCP. Empty COMMAND keeps the local SQLite knowledge base.
# Example for the MIT-licensed china-law-mcp (install/run it yourself first):
# YIFAZHILIAN_LEGAL_MCP_COMMAND=uvx
# YIFAZHILIAN_LEGAL_MCP_ARGS=china-law-mcp
# YIFAZHILIAN_LEGAL_MCP_TIMEOUT=30

# PKU Law (北大法宝) speaks streamable HTTP, so it goes through the local stdio bridge.
# Fill in the platform-specific absolute paths and the Bearer token from the console.
# YIFAZHILIAN_LEGAL_MCP_COMMAND=C:\path\to\backend\.venv\Scripts\python.exe
# YIFAZHILIAN_LEGAL_MCP_ARGS=-m app.services.pkulaw_bridge
# YIFAZHILIAN_LEGAL_MCP_CWD=C:\path\to\backend
# YIFAZHILIAN_LEGAL_MCP_TOKEN=
# YIFAZHILIAN_LEGAL_MCP_UPSTREAM=https://apim-gateway.pkulaw.com/mcp-law-search-service

