# Local material, credentials, and patient data never belong in Git.
.work/
.env
.env.*
!.env.example
.venv/
.ocr-venv/
__pycache__/
.pytest_cache/
pytest-tmp/
.pytest-tmp/
.pytest-run1/
*.py[cod]
*.db
*.db-*
*.sqlite*
*.log
uploads/
private-data/
data/
models/
node_modules/
miniprogram_npm/
project.private.config.json
.DS_Store
Thumbs.db

# pytest 临时目录（basetemp 落到仓库内时产生）
pytest-of-*/
backend/pytest-of-*/

# 部署时生成的实际配置（含密钥）
deploy/env

# 演示用空库：只含表结构与内置演示数据（无真实账号），允许入库。
# data/ 被整体忽略，所以要先解除目录忽略，再只放行这一个文件。
!backend/data/
backend/data/*
!backend/data/demo.db

# 云托管 CLI 生成的部署包
.cloudrun_*.zip
dist/
